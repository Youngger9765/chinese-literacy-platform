on","slug":null,"idx":null,"text":"破壞。","n":3,"ssz":"..."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"兵荒馬亂","n":4,"ssz":"...."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"形容很亂、很緊張的情況。","n":12,"ssz":"............"},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"笑逐顏開","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"笑得很開心，臉上充滿笑容。","n":13,"ssz":".1..........."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"重拾","n":2,"ssz":"1."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"重新找回或重新開始。","n":10,"ssz":"1....1...."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"忐忑不安","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"心裡很緊張，覺得不放心。","n":12,"ssz":".......11..."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"即興","n":2,"ssz":".1"},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"沒有事先準備，當場想到就做。","n":14,"ssz":".............."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"氛圍","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"周圍的感覺或氣氛","n":8,"ssz":"........"},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"緩解","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"舒緩、減輕。","n":6,"ssz":"......"},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"忘卻","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"忘記、遺忘。","n":6,"ssz":"......"},{"section":"served:vocabulary[11].word","slug":null,"idx":null,"text":"追溯","n":2,"ssz":".."},{"section":"served:vocabulary[11].definition","slug":null,"idx":null,"text":"回想或查找過去的事情。","n":11,"ssz":"..........."},{"section":"served:vocabulary[12].word","slug":null,"idx":nul