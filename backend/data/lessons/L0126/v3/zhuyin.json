d:spotlight_v2.blocks[12].items[2].blanks[0].answer","slug":null,"idx":null,"text":"父母平安回家","n":6,"ssz":"......"},{"section":"served:spotlight_v2.blocks[13].label","slug":null,"idx":null,"text":"3.把前面的推論合起來","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[13].prompt","slug":null,"idx":null,"text":"把父母的動機和作者的內心合起來看，可以看出什麼？（2選1）","n":29,"ssz":"......1......................"},{"section":"served:spotlight_v2.blocks[13].options.1","slug":null,"idx":null,"text":"父母為了維持家計想盡辦法，作者也期待他們靠賭博改善生活。","n":28,"ssz":"..1........................."},{"section":"served:spotlight_v2.blocks[13].options.2","slug":null,"idx":null,"text":"父母為了維持家計想盡辦法，但其中賭博的做法讓作者感到難堪與擔心。","n":32,"ssz":"..1............................."},{"section":"served:spotlight_v2.blocks[14].text","slug":null,"idx":null,"text":"二、師長支持與作者讀書行動\n請閱讀下面的課文。你可以一邊讀，一邊把角色做的事畫線。","n":41,"ssz":"...1......................2...2..1......."},{"section":"served:spotlight_v2.blocks[14].text#line","slug":null,"idx":null,"text":"二、師長支持與作者讀書行動","n":13,"ssz":"...1........."},{"section":"served:spotlight_v2.blocks[14].text#line","slug":null,"idx":null,"text":"請閱讀下面的課文。你可以一邊讀，一邊把角色做的事畫線。","n":27,"ssz":"............2...2..1......."},{"section":"served:spotlight_v2.blocks[15].label","slug":null,"idx":null,"text":"（課文第九段）","n":7,"ssz":"......."},{"section":"served:spotlight_v2.blocks[15].paragraphs[0]","slug":null,"idx":null,"text":"「導師了解我的處境，每學期都會悄悄送我參考書；理化老師讓我晚上到他空著的宿舍自習，雖然只去幾次，卻讓我倍感溫暖。」","n":57,"ssz":"...1....................................................."},{"section":"served:spotlight_v2.blocks[16].label","slug":null,"idx":null,"text":"1.推論老師的動機","n":9,"ssz":"........."},{"section":"served:spotlight_v2.blocks[16].items[0].prompt","slug":null,"idx":null,"text":"❶找言行：兩位老師分別做了什麼？導師：【　】；理化老師：【　】","n":31,"ssz":"..............................."},{"section":"served:spotlight_v2.blocks[16].items[0].blanks[0].answer","slug":null,"idx":null,"text":"送作者參考書","n":6,"ssz":"......"},{"section":"served:spotlight_v2.blocks[16].items[0].blanks[1].answer","slug":null,"idx":null,"text":"讓作者用他的宿舍讀書","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[16].items[1].prompt","slug":null,"idx":null,"text":"❷看情境：作者當時處在什麼情境中？（2選1）","n":22,"ssz":"......................"},{"section":"served:spotlight_v2.blocks[16].items[1].options.1","slug":null,"idx":null,"text":"成績太差，不願意讀書","n":10,"ssz":".....1...."},{"section":"served:spotlight_v2.blocks[16].items[1].options.2","slug":null,"idx":null,"text":"家境困難，也缺少安靜的讀書環境","n":15,"ssz":"..............."},{"section":"served:spotlight_v2.blocks[16].items[2].prompt","slug":null,"idx":null,"text":"❸推內心：動機：兩位老師幫助作者的共同動機，最可能是什麼？（2選1）","n":34,"ssz":".................................."},{"section":"served:spotlight_v2.blocks[16].items[2].options.1","slug":null,"idx":null,"text":"了解作者的困難，想支持她繼續學習","n":16,"ssz":"1..............."},{"section":"served:spotlight_v2.blocks[16].items[2].options.2","slug":null,"idx":null,"text":"希望作者進步後，替老師贏得比賽榮譽","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[17].text","slug":null,"idx":null,"text":"2.推論作者的想法和動機\n請閱讀下面的課文。你可以一邊讀，一邊把角色做的事畫線","n":39,"ssz":".........1...............2...2..1......"},{"section":"served:spotlight_v2.blocks[17].text#line","slug":null,"idx":null,"text":"2.推論作者的想法和動機","n":12,"ssz":".........1.."},{"section":"served:spotlight_v2.blocks[17].text#line","slug":null,"idx":null,"text":"請閱讀下面的課文。你可以一邊讀，一邊把角色做的事畫線","n":26,"ssz":"............2...2..1......"},{"section":"served:spotlight_v2.blocks[18].paragraphs[0]","slug":null,"idx":null,"text":"「在紛亂的生活中，我逐漸摸索出讀書的時機與訣竅。顧檳榔攤時最怕遇見同學，我乾脆埋頭寫練習卷避開尷尬。電影放映時，我在戲院入口看門或顧車，沒有桌子，我便拿著需要記誦的課本，一邊背一邊來回踱步。需要計算的科目則留到打烊後，奶奶嫌電費貴，不准我開燈，我便等她熟睡後，再打開桌上小檯燈，在縫隙滲出的微光下解題。」","n":152,"ssz":"..............................................................1........1.............2..2.....................1.............................1..........."},{"section":"served:spotlight_v2.blocks[18].note","slug":null,"idx":null,"text":"這一段是課文第 9 段的節錄改寫（教材自己刪去中間數句），不等於課文原段落","n":37,"ssz":".1..................................."},{"section":"served:spotlight_v2.blocks[19].prompt","slug":null,"idx":null,"text":"❶找言行：作者做了哪些事？","n":13,"ssz":"............."},{"section":"served:spotlight_v2.blocks[19].options.1","slug":null,"idx":null,"text":"顧檳榔攤時寫練習卷","n":9,"ssz":"........."},{"section":"served:spotlight_v2.blocks[19].options.2","slug":null,"idx":null,"text":"看門或顧車時背課本","n":9,"ssz":"1........"},{"section":"served:spotlight_v2.blocks[19].options.3","slug":null,"idx":null,"text":"打烊後在微光下解題","n":9,"ssz":"........."},{"section":"served:spotlight_v2.blocks[19].options.4","slug":null,"idx":null,"text":"等到家中環境改善後，再開始認真讀書","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[20].prompt","slug":null,"idx":null,"text":"❷看情境：當時作者處在什麼情境中？","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[20].options.1","slug":null,"idx":null,"text":"每天都有安靜、明亮的讀書空間。","n":15,"ssz":"..............."},{"section":"served:spotlight_v2.blocks[20].options.2","slug":null,"idx":null,"text":"要幫家裡工作，也缺少合適的讀書環境","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[21].items[0].prompt","slug":null,"idx":null,"text":"⑴把作者的行動和情境合起來，她當時最可能有什麼想法？（單選）","n":30,"ssz":".......1......................"},{"section":"served:spotlight_v2.blocks[21].items[0].options.1","slug":null,"idx":null,"text":"讀書環境太差，即使努力也無法改變結果。","n":19,"ssz":"..................."},{"section":"served:spotlight_v2.blocks[21].items[0].options.2","slug":null,"idx":null,"text":"環境雖然不好，我仍能找時間和方法學習。","n":19,"ssz":".............1....."},{"section":"served:spotlight_v2.blocks[21].items[1].prompt","slug":null,"idx":null,"text":"⑵作者不斷想辦法讀書，她的動機可能是什麼？（單選）","n":25,"ssz":"...1....................."},{"section":"served:spotlight_v2.blocks[21].items[1].options.1","slug":null,"idx":null,"text":"想得到客人的稱讚，證明自己是一個用功的學生。","n":22,"ssz":"...............1......"},{"section":"served:spotlight_v2.blocks[21].items[1].options.2","slug":null,"idx":null,"text":"想藉由持續學習，為自己走出不同的人生。","n":19,"ssz":"........1..