..."},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"殆盡","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"幾乎全部消失或用完。","n":10,"ssz":"1........."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"諮詢","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"詢問、徵求意見。","n":8,"ssz":"........"},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"精神抖擻","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"非常有精神的樣子。","n":9,"ssz":".......1."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"震懾","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"受到強烈的力量或景象影響，感到震驚、害怕。","n":21,"ssz":"....................."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"畏懼","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"害怕，恐懼。","n":6,"ssz":"......"},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"與…為伍","n":4,"ssz":"...."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"和……相處、作伴。","n":9,"ssz":"1..1....."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"有生之年","n":4,"ssz":"...."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"人還活在世上的時間。","n":10,"ssz":".........."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"拋家棄子","n":4,"ssz":"...1"},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"離開家庭，不管孩子。","n":10,"ssz":"........1."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"籌措","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"想辦法準備或募集所需的資金、物資。","n":17,"ssz":"................."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"我們站在山腳下(　)高聳的山峰，感受到大自然的壯麗。","n":26,"ssz":".........................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"面對強大的對手，他心中雖有些(　)，仍然勇敢上場。","n":25,"ssz":"........................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"他多年不回家，也不照顧孩子，親友都批評他 (　)。","n":25,"ssz":"........1...1............"},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"在這個偏遠山村裡，村民遇到問題時，常向村長(　)。","n":25,"ssz":"..1.................1...."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"當山崩發生時，所有人看到土石滑落的景象，都被(　)住了。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"為了完成這個工程，我們需要(　)大量資金。","n":21,"ssz":"1....1..............."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"爺爺都已經80歲了，看起來仍然（　），元氣十足。","n":24,"ssz":".1......................"},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"因為一再失敗，我們原來的雄心壯志已經消磨（　）。","n":24,"ssz":".11....................."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列「　」中的語詞，哪一項使用不恰當？","n":19,"ssz":"...........1...1..."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"他們歷經千辛萬苦，終於「籌措」到開店所需的資金","n":23,"ssz":"......................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"眼前如詩如畫的景象，深深「震懾」了所有在場的人","n":23,"ssz":"......................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"一場無情大火，把他們辛苦建立的家園燒得「殆盡」","n":23,"ssz":"..................1...."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"走進山林，迎面而來的「沁涼」空氣令人神清氣爽","n":22,"ssz":"......................"},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"下列對賴桑人物特質與課文證據的配對，哪一項最不合理？","n":26,"ssz":"...................1......"},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"熱愛自然——從小與大自然為伍，工作之餘常上山看神木","n":25,"ssz":"........................."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"堅持理想——面對親友的不理解，仍持續種樹三十多年","n":24,"ssz":"..................1....."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"勇於行動——清運垃圾、人工除草，並鋪設水管照顧樹苗","n":25,"ssz":"........................."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"重視名聲——愈來愈多人注意他的事，連總統也上山感謝他","n":26,"ssz":".........................."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"賴桑為什麼不用化學肥料和除草劑，改以人工除草？","n":23,"ssz":"..1..1.....1..........."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"為了保留雜草覆蓋土壤，避免水分太快流失","n":19,"ssz":"1.............1...."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"為了避免繼續破壞土質，讓樹苗順利長大","n":18,"ssz":"1...............1."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"為了減少種樹花費，把經費留給購買樹苗","n":18,"ssz":"1...1............."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"為了提高除草效率，加快完成種樹的速度","n":18,"ssz":"1............1...."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據第7段，哪一項最能說明賴太太如何支持賴桑種樹？","n":25,"ssz":".......1.......1......1.."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"扛起家庭與公司的責任，並持續籌措種樹資金。","n":21,"ssz":"................1...."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"先反對丈夫上山種樹，後來才逐漸接受他的選擇。","n":22,"ssz":".......1.............."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"把家庭與公司交給兒子，自己上山協助種植樹苗。","n":22,"ssz":".........1.......1...."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"等待森林已有成果後，才開始提供種樹所需經費。","n":22,"ssz":"...............1......"},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"下列哪一項不是賴桑種樹或推廣種樹想達成的目標？","n":23,"ssz":"...1.1...1....1........"},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"在有生之年種下五十萬棵臺灣珍貴樹木","n":17,"ssz":".....1..........."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"影響更多人一起加入種樹與守護山林的行列","n":19,"ssz":".....2...1.......1."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"透過名人和媒體宣傳，打造自己的品牌形象","n":19,"ssz":"....1.............."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"為下一代留下美麗而珍貴的森林寶藏。","n":17,"ssz":"..1............1."},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜210字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"211~240字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞241字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（一    )開始朗讀，計時1分鐘讀的字數，並記錄在表格中。如果你計時3次後，對自己還不滿意，可以自己多練幾次喔。最後一次，找一位同學，請他來計時、記錄並簽名！","n":91,"ssz":"..................................................................1.......1................"},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.benchmark_label","slug":null,"idx":null,"text":"◎ 我的表現","n":6,"ssz":"......"},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"臺灣有個種樹達人，名叫賴倍元，大家都稱他為賴桑。","n":24,"ssz":"...11..................."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.answer_carrier","slug":null,"idx":null,"text":"紅色 ☑（w:sym Wingdings F0FE，在文字層但非 ☑ 字元）與橘色手寫字","n":44,"ssz":"............................................"},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"自我提問策略：一邊讀、一邊問自己\n你閱讀時，會不會一邊讀，一邊在心裡問自己問題？例如「主角想做什麼？」「我能回答剛才的問題嗎？」這種一邊讀、一邊問自己的方法，叫做自我提問策略。\n這篇文章寫賴桑如何實現種樹志願。很多寫人物努力完成一件事的文章，常沿著一條故事線發展：\n想做什麼→遇到困難，怎麼繼續做→最後有什麼成果與改變\n閱讀時，可以跟著故事發展，選一個問題問自己。讀完後，再檢查：我能完整回答，也找得到課文線索嗎？\n先跟著老師一起做，再換你自己試試看。","n":226,"ssz":".......2...2...........1.2...2..............1.....................2...2.............................1..........................................................................1.....................................2............"},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"自我提問策略：一邊讀、一邊問自己","n":16,"ssz":".......2...2...."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"你閱讀時，會不會一邊讀，一邊在心裡問自己問題？例如「主角想做什麼？」「我能回答剛才的問題嗎？」這種一邊讀、一邊問自己的方法，叫做自我提問策略。","n":71,"ssz":"......1.2...2..............1.....................2...2................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"這篇文章寫賴桑如何實現種樹志願。很多寫人物努力完成一件事的文章，常沿著一條故事線發展：","n":43,"ssz":"...........1..............................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"想做什麼→遇到困難，怎麼繼續做→最後有什麼成果與改變","n":26,"ssz":".........................."},{"section":"se