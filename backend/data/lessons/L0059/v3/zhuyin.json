ng.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.benchmark_label","slug":null,"idx":null,"text":"◎ 我的表現","n":6,"ssz":"......"},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"但這次，我繫著這條紅領帶，參加媽媽的告別式。我1","n":24,"ssz":"................1......."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"文章重點表已經整理了媽媽和家人經歷的事情。接下來，我們不只要看「發生了什麼」，還要把媽媽面對病痛時的不同反應合起來，找出背後共同的信念。\n接著再看看：這個信念如何影響家人和作者，最後成為紅領帶的重要意義。","n":102,"ssz":"...........11..............................1.........1......................1........................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"文章重點表已經整理了媽媽和家人經歷的事情。接下來，我們不只要看「發生了什麼」，還要把媽媽面對病痛時的不同反應合起來，找出背後共同的信念。","n":68,"ssz":"...........11..............................1.........1.............."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"接著再看看：這個信念如何影響家人和作者，最後成為紅領帶的重要意義。","n":33,"ssz":".......1........................."},{"section":"served:spotlight_v2.blocks[1].label","slug":null,"idx":null,"text":"一、從媽媽的反應找出共同信念","n":14,"ssz":"....1..1......"},{"section":"served:spotlight_v2.blocks[1].instruction","slug":null,"idx":null,"text":"媽媽的病痛一步步加重，但她每次面對病痛的方式不完全相同。請讀媽媽的反應，選出主要的面對方式。","n":46,"ssz":".1...1...................1.....1..1..........."},{"section":"served:spotlight_v2.blocks[1].answer_carrier","slug":null,"idx":null,"text":"紅色 ☑（圖形），文字流無此資訊（被勾中的 □ 從文字流消失）","n":31,"ssz":"..............................."},{"section":"served:spotlight_v2.blocks[1].items[0].table_header[0]","slug":null,"idx":null,"text":"媽媽面對病痛時的反應","n":10,"ssz":".1.......1"},{"section":"served:spotlight_v2.blocks[1].items[0].table_header[1]","slug":null,"idx":null,"text":"這個反應主要表現什麼？","n":11,"ssz":".1.1......."},{"section":"served:spotlight_v2.blocks[1].items[0].items[0].label","slug":null,"idx":null,"text":"1.沒有胃、無法躺著睡，媽媽說：「沒有胃就不會胃痛了。」","n":28,"ssz":".............1.......1......"},{"section":"served:spotlight_v2.blocks[1].items[0].items[1].label","slug":null,"idx":null,"text":"2.化療後身體很虛弱，媽媽說可以整天躺在沙發上看球賽","n":26,"ssz":"............1............."},{"section":"served:spotlight_v2.blocks[1].items[0].items[2].label","slug":null,"idx":null,"text":"3.不能進食，只能喝一點點水，媽媽說：「這水好甜，好好喝喔。」","n":31,"ssz":"..........2.....1...........1.."},{"section":"served:spotlight_v2.blocks[1].items[0].items[3].label","slug":null,"idx":null,"text":"4.醫師建議不再繼續化療，媽媽說：「有一天我們還會在天父那裡再見哦。」","n":35,"ssz":"......1.......1...................."},{"section":"served:spotlight_v2.blocks[1].items[1].prompt","slug":null,"idx":null,"text":"1.媽媽面對病痛方式雖然不同，背後哪個信念一直沒有改變？（單選）","n":32,"ssz":"...1..............1..2.........."},{"section":"served:spotlight_v2.blocks[1].items[1].options.1","slug":null,"idx":null,"text":"只要保持喜樂，病情最後就會慢慢好轉。","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[1].items[1].options.2","slug":null,"idx":null,"text":"不能決定病痛如何發展，仍可以選擇如何面對。","n":21,"ssz":"....................."},{"section":"served:spotlight_v2.blocks[1].items[1].options.3","slug":null,"idx":null,"text":"為了不讓家人難過，應把痛苦全部藏在心裡。","n":20,"ssz":"1.1................."},{"section":"served:spotlight_v2.blocks[1].items[2].prompt","slug":null,"idx":null,"text":"2.課文說：「我們下定決心要跟媽媽看齊。」這可以看出媽媽的做法對家人產生什麼影響？（單選）","n":45,"ssz":"................1..........1................."},{"section":"served:spotlight_v2.blocks[1].items[2].options.1","slug":null,"idx":null,"text":"讓家人相信媽媽的病情其實沒有那麼嚴重。","n":19,"ssz":"...1..1............"},{"section":"served:spotlight_v2.blocks[1].items[2].options.2","slug":null,"idx":null,"text":"讓家人看見，面對無法改變的事仍能作出選擇。","n":21,"ssz":"....................."},{"section":"served:spotlight_v2.blocks[1].items[2].options.3","slug":null,"idx":null,"text":"讓家人不用再擔心，也不必陪伴媽媽治療。","n":19,"ssz":"...1......1....1..."},{"section":"served:spotlight_v2.blocks[2].text","slug":null,"idx":null,"text":"你發現了嗎？\n媽媽有時用幽默，有時表達感謝，有時依靠信仰。做法雖然不同，背後的信念卻相同：\n→很多事不能掌控，但仍可以選擇如何面對。\n→這個信念不只幫助媽媽，也影響了家人和作者。","n":89,"ssz":"........1.................................1..........................1.......1..........."},{"section":"served:spotlight_v2.blocks[2].text#line","slug":null,"idx":null,"text":"你發現了嗎？","n":6,"ssz":"......"},{"section":"served:spotlight_v2.blocks[2].text#line","slug":null,"idx":null,"text":"媽媽有時用幽默，有時表達感謝，有時依靠信仰。做法雖然不同，背後的信念卻相同：","n":38,"ssz":".1.................................1.."},{"section":"served:spotlight_v2.blocks[2].text#line","slug":null,"idx":null,"text":"→很多事不能掌控，但仍可以選擇如何面對。","n":20,"ssz":"...................."},{"section":"served:spotlight_v2.blocks[2].text#line","slug":null,"idx":null,"text":"→這個信念不只幫助媽媽，也影響了家人和作者。","n":22,"ssz":"..1.......1..........."},{"section":"served:spotlight_v2.blocks[3].label","slug":null,"idx":null,"text":"二、看信念如何由媽媽走向作者","n":14,"ssz":".........1...."},{"section":"served:spotlight_v2.blocks[3].answer_carrier","slug":null,"idx":null,"text":"紅色 ☑（圖形）與橘色手寫字；☑ 不在文字流，橘字已在文字流的【】內","n":34,"ssz":".................1................"},{"section":"served:spotlight_v2.blocks[3].items[0].prompt","slug":null,"idx":null,"text":"1.作者說「跟媽媽看齊」最接近什麼意思？（單選）","n":24,"ssz":"........1.........2....."},{"section":"served:spotlight_v2.blocks[3].items[0].options.1","slug":null,"idx":null,"text":"要求自己和媽媽一樣，完全不害怕死亡","n":17,"ssz":"1...1.11....1...."},{"section":"served:spotlight_v2.blocks[3].items[0].options.2","slug":null,"idx":null,"text":"學習媽媽面對無法掌控之事的方式。","n":16,"ssz":"...1............"},{"section":"served:spotlight_v2.blocks[3].items[1].prompt","slug":null,"idx":null,"text":"2.請完成「信念被承接」的歷程","n":15,"ssz":"..............."},{"section":"served:spotlight_v2.blocks[3].items[1].columns[0]","slug":null,"idx":null,"text":"信念的發展","n":5,"ssz":"....."},{"section":"served:spot