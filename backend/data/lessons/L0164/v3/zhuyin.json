sz":".."},{"section":"served:word_matching.items[5].文言","slug":null,"idx":null,"text":"還自揚州，復到舅家，問焉。曰：「泯然眾人矣。」","n":23,"ssz":"......................."},{"section":"served:word_matching.items[5].白話","slug":null,"idx":null,"text":"我(　)揚州(　)，又到舅舅家，問起他。舅舅說：「他的才能已經(　)，變得跟普通人一樣了。」","n":46,"ssz":".............1.......1..............1....1...."},{"section":"served:word_matching.items[5].blanks[0].answer","slug":null,"idx":null,"text":"從","n":1,"ssz":"."},{"section":"served:word_matching.items[5].blanks[1].answer","slug":null,"idx":null,"text":"回來","n":2,"ssz":".."},{"section":"served:word_matching.items[5].blanks[2].answer","slug":null,"idx":null,"text":"消失","n":2,"ssz":".."},{"section":"served:sentence_matching.label","slug":null,"idx":null,"text":"ㄧ、文白句子比對","n":8,"ssz":".....1.."},{"section":"served:sentence_matching.instruction","slug":null,"idx":null,"text":"請模仿例句作法：\n❶閱讀參考句；❷找出參考句對應的原文；❸將對應的原文(  )起來\n❹在下方的[  ]寫上參考句代號。","n":59,"ssz":".......................1.......1..........................."},{"section":"served:sentence_matching.instruction#line","slug":null,"idx":null,"text":"請模仿例句作法：","n":8,"ssz":"........"},{"section":"served:sentence_matching.instruction#line","slug":null,"idx":null,"text":"❶閱讀參考句；❷找出參考句對應的原文；❸將對應的原文(  )起來","n":32,"ssz":"..............1.......1........."},{"section":"served:sentence_matching.instruction#line","slug":null,"idx":null,"text":"❹在下方的[  ]寫上參考句代號。","n":17,"ssz":"................."},{"section":"served:sentence_matching.parts[0].label","slug":null,"idx":null,"text":"第一題：","n":4,"ssz":"...."},{"section":"served:sentence_matching.parts[0].example.文言","slug":null,"idx":null,"text":"金谿民方仲永","n":6,"ssz":"......"},{"section":"served:sentence_matching.parts[0].reference_sentences.1","slug":null,"idx":null,"text":"從不曾見過寫字的紙、筆","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[0].reference_sentences.2","slug":null,"idx":null,"text":"仲永長到五歲時","n":7,"ssz":"......."},{"section":"served:sentence_matching.parts[0].reference_sentences.3","slug":null,"idx":null,"text":"金谿地方有一個人名叫方仲永","n":13,"ssz":"......1......"},{"section":"served:sentence_matching.parts[0].reference_sentences.4","slug":null,"idx":null,"text":"有一天，他忽然哭著求要紙、筆","n":14,"ssz":".............."},{"section":"served:sentence_matching.parts[0].reference_sentences.5","slug":null,"idx":null,"text":"他立刻寫了一首四句詩，並寫上自己的名字","n":19,"ssz":".....2............1"},{"section":"served:sentence_matching.parts[0].reference_sentences.6","slug":null,"idx":null,"text":"他的父親很訝異這件事，就跟鄰居借來給他","n":19,"ssz":"..................."},{"section":"served:sentence_matching.parts[0].reference_sentences.7","slug":null,"idx":null,"text":"他們家世代都以種田為業","n":11,"ssz":".......1..."},{"section":"served:sentence_matching.parts[0].items[0].文言","slug":null,"idx":null,"text":"世隸耕","n":3,"ssz":"..."},{"section":"served:sentence_matching.parts[0].items[1].文言","slug":null,"idx":null,"text":"仲永生五年","n":5,"ssz":"....."},{"section":"served:sentence_matching.parts[0].items[2].文言","slug":null,"idx":null,"text":"未嘗識書具","n":5,"ssz":"....."},{"section":"served:sentence_matching.parts[0].items[3].文言","slug":null,"idx":null,"text":"忽啼求之","n":4,"ssz":"...."},{"section":"served:sentence_matching.parts[0].items[4].文言","slug":null,"idx":null,"text":"父異焉，借旁近與之","n":9,"ssz":"........."},{"section":"served:sentence_matching.parts[0].items[5].文言","slug":null,"idx":null,"text":"即書詩四句，並自為其名","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[1].label","slug":null,"idx":null,"text":"第二題：","n":4,"ssz":"...."},{"section":"served:sentence_matching.parts[1].reference_sentences.1","slug":null,"idx":null,"text":"自從這件事後，指定任何事物叫他作詩，他都能立刻作出來","n":26,"ssz":".........................."},{"section":"served:sentence_matching.parts[1].reference_sentences.2","slug":null,"idx":null,"text":"還傳給全鄉的秀才觀看","n":10,"ssz":".........."},{"section":"served:sentence_matching.parts[1].reference_sentences.3","slug":null,"idx":null,"text":"有的人會用錢來求他作詩","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[1].reference_sentences.4","slug":null,"idx":null,"text":"鄉裡的人驚奇仲永的天才，漸漸地都以賓客之禮對待他父親","n":26,"ssz":"..............1..........."},{"section":"served:sentence_matching.parts[1].reference_sentences.5","slug":null,"idx":null,"text":"而且詩的文采和道理都很值得欣賞","n":15,"ssz":"......1.....1.."},{"section":"served:sentence_matching.parts[1].reference_sentences.6","slug":null,"idx":null,"text":"這首詩是寫奉養父母、團結親族的意思","n":17,"ssz":"......1.........2"},{"section":"served:sentence_matching.parts[1].reference_sentences.7","slug":null,"idx":null,"text":"他的父親為了利益的緣故","n":11,"ssz":"....1......"},{"section":"served:sentence_matching.parts[1].reference_sentences.8","slug":null,"idx":null,"text":"天天拉著兒子四處拜訪鄉人，沒有讓他學習","n":19,"ssz":".....1.1..........."},{"section":"served:sentence_matching.parts[1].items[0].文言","slug":null,"idx":null,"text":"其詩以.養父母、收族為意","n":12,"ssz":"............"},{"section":"served:sentence_matching.parts[1].items[1].文言","slug":null,"idx":null,"text":"傳一鄉秀才觀之","n":7,"ssz":".2....."},{"section":"served:sentence_matching.parts[1].items[2].文言","slug":null,"idx":null,"text":"自是指物作詩立就","n":8,"ssz":"........"},{"section":"served:sentence_matching.parts[1].items[3].文言","slug":null,"idx":null,"text":"其文理皆有可觀者","n":8,"ssz":"........"},{"section":"served:sentence_matching.parts[1].items[4].文言","slug":null,"idx":null,"text":"邑人奇之，稍稍賓客其父","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[1].items[5].文言","slug":null,"idx":null,"text":"或以錢幣乞之","n":6,"ssz":"......"},{"section":"served:sentence_matching.parts[1].items[6].文言","slug":null,"idx":null,"text":"父利其然也","n":5,"ssz":"....."},{"section":"served:sentence_matching.parts[1].items[7].文言","slug":null,"idx":null,"text":"日扳仲永.環謁於邑人，不使學","n":14,"ssz":".............."},{"section":"served:sentence_matching.parts[2].label","slug":null,"idx":null,"text":"第三題：","n":4,"ssz":"...."},{"section":"served:sentence_matching.parts[2].reference_sentences.1","slug":null,"idx":null,"text":"叫他作詩，寫的詩卻不如先前傳聞的那麼好","n":19,"ssz":"..................."},{"section":"served:sentence_matching.parts[2].reference_sentences.2","slug":null,"idx":null,"text":"明道年間，我跟從父親回鄉","n":12,"ssz":"............"},{"section":"served:sentence_matching.parts[2].reference_sentences.3","slug":null,"idx":null,"text":"又到舅舅家，問起他","n":9,"ssz":"...1....."},{"section":"served:sentence_matching.parts[2].reference_sentences.4","slug":null,"idx":null,"text":"在舅舅家見過他，當時他大約十二、三歲","n":18,"ssz":"..1..............."},{"section":"served:sentence_matching.parts[2].reference_sentences.5","slug":null,"idx":null,"text":"又過七年，我從揚州回來","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[2].reference_sentences.6","slug":null,"idx":null,"text":"舅舅說：「他的才能已經消失，變得跟普通人一樣了。」","n":25,"ssz":".1.............1....1...."},{"section":"served:sentence_matching.parts[2].items[1].文言","slug":null,"idx":null,"text":"明道中，從先人還家","n":9,"ssz":"........."},{"section":"served:sentence_matching.parts[2].items[2].文言","slug":null,"idx":null,"text":"於舅家見之，十二三矣","n":10,"ssz":".........."},{"section":"served:sentence_matching.parts[2].items[2].文言_source_text","slug":null,"idx":null,"text":"於舅家見之，十二三","n":9,"ssz":"........."},{"section":"served:sentence_matching.parts[2].items[3].文言","slug":null,"idx":null,"text":"令作詩，不能稱前時之聞","n":11,"ssz":"..........."},{"section":"served:sentence_matching.parts[2].items[4].文言","slug":null,"idx":null,"text":"又七年，還自揚州","n":8,"ssz":"........"},{"section":"served:sentence_matching.parts[2].items[5].文言","slug":null,"idx":null,"text":"復到舅家，問焉","n":7,"ssz":"......."},{"section":"served:sentence_matching.parts[2].items[6].文言","slug":null,"idx":null,"text":"曰：「泯然2.眾人矣。」","n":12,"ssz":"............"},{"section":"served:goal_box.category","slug":null,"idx":null,"text":"文言文類型","n":5,"ssz":"....."},{"section":"served:goal_box.category_value","slug":null,"idx":null,"text":"記敘人物","n":4,"ssz":"...."},{"section":"served:goal_box.title","slug":null,"idx":null,"text":"第9課  從天才跌為凡人的神童","n":15,"ssz":"..............."},{"section":"served:goal_bo