:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.benchmark_label","slug":null,"idx":null,"text":"◎ 我的表現","n":6,"ssz":"......"},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"看在眼裡，我突然覺得自己「受騙」了，一定是她拿到","n":24,"ssz":".........1........1....."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"　　作者在文章前面總覺得自己好慘、別人比較幸運；到了文章最後，遇到不順利的事，他卻總說「太精采了」「太棒了」。\n發生的事情真的都變好了嗎？並沒有。改變的是作者看事情的想法。\n接下來，我們先整理作者舉出的三個生活例子，找出他共同使用的轉念方法，再用這些例子讀懂「把手上的餅吃香一點」的意思。最後，試著把這個方法用在自己的生活中。","n":163,"ssz":"...........1.....................1....................................................................1...1...................1..........2....2........1..........."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"　　作者在文章前面總覺得自己好慘、別人比較幸運；到了文章最後，遇到不順利的事，他卻總說「太精采了」「太棒了」。","n":55,"ssz":"...........1.....................1....................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"發生的事情真的都變好了嗎？並沒有。改變的是作者看事情的想法。","n":30,"ssz":".............................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"接下來，我們先整理作者舉出的三個生活例子，找出他共同使用的轉念方法，再用這些例子讀懂「把手上的餅吃香一點」的意思。最後，試著把這個方法用在自己的生活中。","n":76,"ssz":"...............1...1...................1..........2....2........1..........."},{"section":"served:spotlight_v2.blocks[1].text","slug":null,"idx":null