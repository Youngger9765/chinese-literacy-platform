"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"事物的由來。","n":6,"ssz":"......"},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"癲癇","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"一種腦部疾病。發作時可能突然失去意識或身體抽動，症狀因人而不同。","n":32,"ssz":"................................"},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"國際特赦組織","n":6,"ssz":"......"},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"一個關注人權的非政府組織。","n":13,"ssz":"............."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"在討論運動會進場表演時，小明（　），提了一個好點子，大家紛紛拍手叫好。","n":35,"ssz":".....................1..1.........."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"最近兩位消防人員，因裝備老舊，不幸在救災中殉職，老師帶著同學們一起製作海報，（　）消防人員的權益。","n":49,"ssz":"...............1...............2................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"面對同學們的嘲笑，小強選擇（　），繼續專心做自己的事情。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"這個國家被（　）政府統治，人民的自由與人權受到嚴重限制。","n":28,"ssz":".1.........................."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"面對他人不合理的（　），我們應該站出來為自己爭取權益。","n":27,"ssz":"...................1......."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"透過多間學校共同舉辦的「跨校筆友」寫信活動，讓我和原本（　）的小華建立了深厚的友誼。","n":42,"ssz":"........................1................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"這場二手義賣活動的（　），是一群學生想幫助流浪狗。","n":25,"ssz":"........................."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"妹妹在醫院縫合傷口，家屬不能進入陪同，爸爸只能在外面（　）。","n":30,"ssz":".1..................1........."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列語詞何者使用正確？","n":11,"ssz":"..........."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"能成為同班同學是珍貴的「緣起」，我們要好好珍惜","n":23,"ssz":"......................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"因為消息來得太突然，大家「素未謀面」，不知所措","n":23,"ssz":".1...1................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"偏鄉地區醫療資源缺乏，許多民眾生病時「求助無門」","n":24,"ssz":"........................"},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"「突發奇想」的大雨讓行人措手不及，紛紛跑到騎樓下躲雨","n":26,"ssz":".........................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"「信件的力量不僅傳遞關懷，更改變了許多人的命運，讓他們從黑暗走向光明」，關於這句話的詮釋，下列敘述何者正確？","n":54,"ssz":".............1........................................"},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"信件中的關懷，造成他人命運起起伏伏","n":17,"ssz":"................."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"信件的力量，幫助許多人去反省自己糟糕的生活","n":21,"ssz":".............1......."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"信件表達對收件者的關心，也幫助許多人擺脫困境","n":22,"ssz":"......................"},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"信件中的文字，讓許多人認識到他人不同的人生經歷","n":23,"ssz":"......................."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"第1段作者用「你知道嗎？」和「你相信嗎？」兩個問句開頭，主要有什麼作用？","n":36,"ssz":".............1..1.....1............."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"吸引讀者注意，引發對信件力量的好奇","n":17,"ssz":"...............1."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"表示作者懷疑信件是否真的能幫助別人","n":17,"ssz":"................."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"說明作者不清楚寫信馬拉松活動的由來","n":17,"ssz":"................."},{"section":"served:multiple_choice[2].options[3]","slug"