[4].definition","slug":null,"idx":null,"text":"表示短時間內發生很多次。","n":12,"ssz":"............"},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"敗北","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"失敗。","n":3,"ssz":"..."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"局面","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"事情發展的整體情況。","n":10,"ssz":".........."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"外行人","n":3,"ssz":".1."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"對某領域不熟悉、缺乏專業知識的人。","n":17,"ssz":"................."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"傾盡","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"用盡全部的力量或資源，毫無保留。","n":16,"ssz":"................"},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"契機","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"對轉變與發展有幫助的關鍵機會。","n":15,"ssz":"..............."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"為了準備校慶表演，全班（　）全力練習，希望能有好成績。","n":27,"ssz":"1.........................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"轉學雖然讓他不安，卻也成為認識新朋友的（　）。","n":23,"ssz":"......................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"火車在高雄─屏東間電纜斷裂，乘客（　）詢問車長修復進度。","n":28,"ssz":"......................1....."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"球隊在冠軍賽中（　），大家都感到十分失落。","n":21,"ssz":"....................."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"我是程式設計的（　），懂得很少，需要慢慢學習。","n":23,"ssz":"............1.........."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"他們雖是多年好友，但也是彼此在魔術方塊比賽上的（　）。","n":27,"ssz":"........