[2].word","slug":null,"idx":null,"text":"日新月異","n":4,"ssz":"...."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"每天更新，每月不同；形容進步或變化很快。","n":20,"ssz":"...................."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"翼展","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"兩邊翅膀完全展開時，左右翼尖之間的長度。","n":20,"ssz":"...................."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"蔓延","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"像藤蔓一樣延伸。形容向四周不斷擴展。","n":18,"ssz":"...1.........1...."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"施作","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"依照計畫或方法進行工作。","n":12,"ssz":"............"},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"敵兵來了，就派將士抵擋；水來了，就用土築堤阻擋。比喻針對不同情況，採取適合的應對方法。","n":43,"ssz":".......1..............................1...."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"想方設法","n":4,"ssz":"...."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"想出各種辦法，設法達成目的。","n":14,"ssz":"............2."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"一勞永逸","n":4,"ssz":"2..."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"辛苦一次，以後就不用再費力。","n":14,"ssz":"..1.....1....."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"剋星","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"能克制對方的人或物。","n":10,"ssz":".........."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"活動當天突然下起大雨，大家立刻把攤位移到室內，展現出（　）的應變能力。","n":35,"ssz":"..............................1...."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"現在詐騙手法（　），稍不留意，就容易受騙。","n":21,"ssz":"....................."},{"secti