27,"ssz":".............1............."},{"section":"served:word_matching.items[0].blanks[0].answer","slug":null,"idx":null,"text":"拿下","n":2,"ssz":".."},{"section":"served:word_matching.items[0].blanks[1].answer","slug":null,"idx":null,"text":"做","n":1,"ssz":"."},{"section":"served:word_matching.items[1].classical","slug":null,"idx":null,"text":"魯梁之民俗為綈，公服綈，令左右服之，民從而服之。","n":24,"ssz":"........................"},{"section":"served:word_matching.items[1].boxed_terms[0]","slug":null,"idx":null,"text":"俗","n":1,"ssz":"."},{"section":"served:word_matching.items[1].boxed_terms[1]","slug":null,"idx":null,"text":"服","n":1,"ssz":"."},{"section":"served:word_matching.items[1].boxed_terms[2]","slug":null,"idx":null,"text":"左右","n":2,"ssz":".."},{"section":"served:word_matching.items[1].vernacular","slug":null,"idx":null,"text":"魯梁的人民（　）織綈來穿，主公可以帶頭（　）綈做的衣服，並命令（　）穿，如此，人民也會跟著穿。","n":47,"ssz":"..............................................."},{"section":"served:word_matching.items[1].blanks[0].answer","slug":null,"idx":null,"text":"習慣","n":2,"ssz":".."},{"section":"served:word_matching.items[1].blanks[2].answer","slug":null,"idx":null,"text":"身邊的人","n":4,"ssz":"...."},{"section":"served:word_matching.items[2].classical","slug":null,"idx":null,"text":"齊勿敢為，必仰於魯梁，則是魯梁釋其農事而作綈矣。","n":24,"ssz":"........................"},{"section":"served:word_matching.items[2].boxed_terms[0]","slug":null,"idx":null,"text":"仰","n":1,"ssz":"."},{"section":"served:word_matching.items[2].boxed_terms[1]","slug":null,"idx":null,"text":"釋","n":1,"ssz":"."},{"section":"served:word_matching.items[2].vernacular","slug":null,"idx":null,"text":"齊國人不敢不聽，勢必（　）魯、梁兩國，向他們購買綈。如此，魯、梁兩國的人民就會（　）農活，爭相去織綈了。","n":52,"ssz":"..............................................1....."},{"section":"served:word_matching.items[2].blanks[0].answer","slug":null,"idx":null,"text":"仰賴","n":2,"ssz":".."},{"section":"served:word_matching.items[2].blanks[1].answer","slug":null,"idx":null,"text":"放下","n":2,"ssz":".."},{"section":"served:word_matching.items[3].classical","slug":null,"idx":null,"text":"魯梁郭中之民，道路揚塵，車轂連伍而行。管子對公曰：「公宜改服帛，率民去綈，毋與魯梁通使。」","n":45,"ssz":"....................1........................"},{"section":"served:word_matching.items[3].boxed_terms[0]","slug":null,"idx":null,"text":"郭中","n":2,"ssz":".."},{"section":"served:word_matching.items[3].vernacular","slug":null,"idx":null,"text":"兩國（　）的人民為了織綈、運綈，忙得路上都塵土飛揚，運綈的車一輛接一輛。管仲於是對齊桓公說：「主公現在可以改（　）一般的絲織品，帶領人民不再穿綈，也不要與魯、梁兩國有任何外交往來。」","n":91,"ssz":"........1........1............1..1.......................2..........1.....1................"},{"section":"served:word_matching.items[3].blanks[0].answer","slug":null,"idx":null,"text":"城裡","n":2,"ssz":".."},{"section":"served:word_matching.items[4].classical","slug":null,"idx":null,"text":"魯梁之人，糴十百，齊糶十錢。","n":14,"ssz":".............."},{"section":"served:word_matching.items[4].vernacular","slug":null,"idx":null,"text":"魯梁的人民（　）十升糧食要花上千錢，而齊國（　）十升糧的成本卻只要十錢。","n":36,"ssz":"...................................."},{"section":"served:word_matching.items[4].blanks[0].answer","slug":null,"idx":null,"text":"買","n":1,"ssz":"."},{"section":"served:word_matching.items[4].blanks[1].answer","slug":null,"idx":null,"text":"賣","n":1,"ssz":"."},{"section":"served:word_matching.items[5].classical","slug":null,"idx":null,"text":"魯梁之民歸齊者十分之六，三年，魯梁之君請服。","n":22,"ssz":"......................"},{"section":"served:word_matching.items[5].vernacular","slug":null,"idx":null,"text":"魯梁的人民為了活下去而投奔齊國的，十人中就有六人，到了第三年，兩國的國君無計可施，只好向齊國請求（　）。","n":52,"ssz":".....1.............................................."},{"section":"served:word_matching.items[5].blanks[0].answer","slug":null,"idx":null,"text":"歸順臣服","n":4,"ssz":"...."},{"section":"served:sentence_matching.instruction","slug":null,"idx":null,"text":"請 ❶ 閱讀原文；❷ 找出對應的參考句；❸ 在下方的[  ]寫上參考句代號。","n":38,"ssz":"..............1......................."},{"section":"served:sentence_matching.passage_paragraphs[0]","slug":null,"idx":null,"text":"桓公曰：「(吾欲下魯梁，何行而可)？」管子對曰：「魯梁之民俗為綈，(公服綈，令左右服之，民從而服之)，公因令齊勿敢為，必仰於魯梁，則是魯梁釋其農事而作綈矣。」桓公曰：「諾。」","n":87,"ssz":"....................1.................................................................."},{"section":"served:sentence_matching.passage_paragraphs[1]","slug":null,"idx":null,"text":"管子告魯梁之賈人曰：「(子為我致綈千匹，賜子金三百斤)，十至而金三千斤，則是魯梁不賦於民而財用足也。」魯梁之君聞之，則教其民為綈。十三月，魯梁郭中之民，(道路揚塵，車轂連伍而行)。管子對公曰：「(公宜改服帛，率民去綈)，毋與魯梁通使。」公曰：「諾。」","n":125,"ssz":".1..........11.......1..................1..................................................1................................."},{"section":"served:sentence_matching.passage_paragraphs[2]","slug":null,"idx":null,"text":"後十月，(魯梁之民，餓餒相及)，魯梁之君，(即令其民去綈修農穀)，不可以三月而得，(魯梁之人，糴十百，齊糶十錢)。二十四月，魯梁之民歸齊者十分之六，三年，魯梁之君請服。","n":84,"ssz":"............1..........................1............................................"},{"section":"served:sentence_matching.reference_label","slug":null,"idx":null,"text":"參考句：","n":4,"ssz":"...."},{"section":"served:sentence_matching.reference_sentences.1","slug":null,"idx":null,"text":"主公現在可以改穿一般的絲織品，帶領人民不再穿綈","n":23,"ssz":"........2..........1..."},{"section":"served:sentence_matching.reference_sentences.2","slug":null,"idx":null,"text":"你們幫我運來一千匹綈，我就賞賜你們三百斤金","n":21,"ssz":"....................."},{"section":"served:sentence_matching.reference_sentences.3","slug":null,"idx":null,"text":"立刻命令人民停止織綈、趕快回去務農種糧","n":19,"ssz":"..................."},{"section":"served:sentence_matching.reference_sentences.4","slug":null,"idx":null,"text":"路上塵土飛揚，運綈的車一輛接一輛","n":16,"ssz":"...........1..1."},{"section":"served:sentence_matching.reference_sentences.5","slug":null,"idx":null,"text":"主公帶頭穿綈做的衣服，並命令身邊的人穿，如此人民也會跟著穿","n":29,"ssz":"............................."},{"section":"served:sentence_matching.reference_sentences.6","slug":null,"idx":null,"text":"魯梁的人民買十升糧食要花上千錢，而齊國賣十升糧的成本卻只要十錢","n":31,"ssz":"..............................."},{"section":"served:sentence_matching.reference_sentences.7","slug":null,"idx":null,"text":"我想拿下魯國和梁國，怎麼做才可以","n":16,"ssz":"......1........."},{"section":"served:sentence_matching.reference_sentences.8","slug":null,"idx":null,"text":"兩國的人民因為缺糧，挨餓的人一個接一個","n":19,"ssz":"......1........1..1"},{"section":"served:sentence_matching.segments[0].classical","slug":null,"idx":null,"text":"吾欲下魯梁，何行而可","n":10,"ssz":".........."},{"section":"served:sentence_matching.segments[1].classical","slug":null,"idx":null,"text":"公服綈，令左右服之，民從而服之","n":15,"ssz":"..............."},{"section":"served:sentence_matching.segments[2].classical","slug":null,"idx":null,"text":"子為我致綈千匹，賜子金三百斤","n":14,"ssz":"11.......1...."},{"section":"served:sentence_matching.segments[3].classical","slug":null,"idx":null,"text":"道路揚塵，車轂連伍而行","n":11,"ssz":"..........."},{"section":"served:sentence_matching.segments[4].classical","slug":null,"idx":null,"text":"公宜改服帛，率民去綈","n":10,"ssz":".........."},{"section":"served:sentence_matching.segments[5].classical","slug":null,"idx":null,"text":"魯梁之民，餓餒相及","n":9,"ssz":".......1."},{"section":"served:sentence_matching.segments[6].classical","slug":null,"idx":null,"text":"即令其民去綈修農穀","n":9,"ssz":"........."},{"section":"served:sentence_matching.segments[7].classical","slug":null,"idx":null,"text":"魯梁之人，糴十百，齊糶十錢","n":13,"ssz":"............."},{"section":"served:self_challenge.instruction","slug":null,"idx":null,"text":"請閱讀以下文章，完成問題。提醒：記得運用文言文的閱讀策略哦！","n":30,"ssz":".................1............"},{"section":"served:self_challenge.strategy_banner","slug":null,"idx":null,"text":"❶斷句 ⭢❷找動詞/形容詞 ⭢❸找/補主語 ⭢❹用自己的話說一說","n":32,"ssz":"................................"},{"section":"served:self_challenge.annotations[0].term","slug":null,"idx":null,"text":"弈","n":1,"ssz":"."},{"section":"served:self_challenge.annotations[0].text","slug":null,"idx":null,"text":"下(圍)棋。","n":6,"ssz":"......"},{"section":"served:self_challenge.annotations[1].term","slug":null,"idx":null,"text":"繳","n":1,"ssz":"."},{"section":"served:self_challenge.annotations[1].text","slug":null,"idx":null,"text":"ㄓㄨㄛˊ，繫在箭尾的絲繩，便於尋找射中的獵物或回收箭枝。","n":28,"ssz":"............................"},{"section":"served:self_challenge.annotations[2].term","slug":null,"idx":null,"text":"弗若","n":2,"ssz":".."},{"section":"served:self_challenge.annotations[2].text","slug":null,"idx":null,"text":"不如。","n":3,"ssz":"..."},{"section":"served:self_challenge.translation","slug":null,"idx":null,"text":"弈秋是全國最會下棋的人。讓弈秋教兩個人下棋，其中一人專心學習，只聽弈秋的教導；另一人雖然也聽課，卻一心以為有大鳥要飛來，總想著要拉弓射鳥。雖然他跟那個專心學棋的人一起學習，棋力卻不如人。是因為他的智力不如人家嗎?(我)說：不是這樣的。","n":117,"ssz":".................1......2...............2........2........................1......2.............1...............1....."},{"section":"served:self_challenge.part_one.label","slug":null,"idx":null,"text":"（一）請依照故事脈絡，回答下列問題。","n":18,"ssz":".................."},{"section":"served:self_challenge.part_one.answer_carrier","slug":null,"idx":null,"text":"橘色手寫（字元樣式 aff6）；第 3、4 題是**橘色圈選**（roundRect FF9900）","n":50,"ssz":".................................................."},{"section":"served:self_challenge.part_one.items[0].stem","slug":null,"idx":null,"text":"斷句後的第一個分句，主語是誰？","n":15,"ssz":"..............."},{"section":"served:self_challenge.part_one.items[0].answer","slug":null,"idx":null,"text":"弈秋","n":2,"ssz":".."},{"section":"served:self_challenge.part_one.items[1].stem","slug":null,"idx":null,"text":"承上題，這個主語怎麼樣或做什麼？","n":16,"ssz":".....1.........."},{"section":"served:self_challenge.part_one.items[1].answer","slug":null,"idx":null,"text":"善弈/很會下棋","n":7,"ssz":"......."},{"section":"served:self_challenge.part_one.items[2].stem","slug":null,"idx":null,"text":"弈秋的兩名學生，一人「專心致志」，從何可知？","n":22,"ssz":"........2............."},{"section":"served:self_challenge.part_one.items[2].options.1","slug":null,"idx":null,"text":"惟弈秋之為聽","n":6,"ssz":"......"},{"section":"served:self_challenge.part_one.items[2].options.2","slug":null,"idx":null,"text":"一心以為有鴻鵠將至","n":9,"ssz":"........."},{"section":"served:self_challenge.part_one.items[2].instruction","slug":null,"idx":null,"text":"(圈出適當答案)","n":8,"ssz":"....1..."},{"section":"served:self_challenge.part_one.items[2].answer_carrier","slug":null,"idx":null,"text":"橘色圈選（roundRect FF9900，1.27×0.33in，尺寸吻合 6 字）圈住「惟弈秋之為聽」","n":53,"ssz":"....................................................."},{"section":"served:self_challenge.part_one.items[3].stem","slug":null,"idx":null,"text":"「雖與之俱學，弗若之矣」是省略主語的句子。請問：主語是誰？","n":29,"ssz":"...................1........."},{"section":"served:self_challenge.part_one.items[3].options.1","slug":null,"idx":null,"text":"惟弈秋之為聽者","n":7,"ssz":"......."},{"section":"served:self_challenge.part_one.items[3].options.2","slug":null,"idx":null,"text":"一心以為有鴻鵠將至者","n":10,"ssz":".........."},{"section":"served:self_challenge.part_one.items[3].answer_carrier","slug":null,"idx":null,"text":"橘色圈選（roundRect FF9900，2.07×0.26in，尺寸吻合 10 字）圈住「一心以為有鴻鵠將至者」","n":58,"ssz":"...............................................2.........."},{"section":"served:self_challenge.part_two.label","slug":null,"idx":null,"text":"（二）閱讀理解測驗","n":9,"ssz":"........."},{"section":"served:self_challenge.part_two.answer_carrier","slug":null,"idx":null,"text":"橘色手寫代號（字元樣式 aff6）","n":17,"ssz":"................."},{"section":"served:self_challenge.part_two.items[0].stem","slug":null,"idx":null,"text":"關於文本內容，下列何者較符合文章主旨?","n":19,"ssz":"..................."},{"section":"served:self_challenge.part_two.items[0].options.A","slug":null,"idx":null,"text":"說明學習需依靠名師指導","n":11,"ssz":"..........."},{"section":"served:self_challenge.part_two.items[0].options.B","slug":null,"idx":null,"text":"強調天資將決定學習成敗","n":11,"ssz":".1........."},{"section":"served:self_challenge.part_two.items[0].options.C","slug":null,"idx":null,"text":"指出專心致志的重要性","n":10,"ssz":".........."},{"section":"served:self_challenge.part_two.items[0].options.D","slug":null,"idx":null,"text":"說明下棋比射箭更難學","n":10,"ssz":".........."},{"section":"served:intro_guide.text","slug":null,"idx":null,"text":"導讀：這課講一個發生在2700年前的精采的故事，說明了戰爭不一定要用兵刃，經濟戰完全不流血，一樣奏效：當時的齊國君主齊桓公，想要侵略魯國和梁國，他的臣子管仲，給他出了主意，在短時間內，讓兩個小國的人民放棄生產糧食，全力投入紡織業，要賣布給齊國。這麼做了一年多，齊國突然不買布了，這時魯、梁不但布賣不出去，連米糧都沒得吃，又要回頭求齊國幫忙。不久後，就自動向齊國臣服投降了。","n":186,"ssz":".......1......................1...............1.....................1.........................1.................................................1............1.........................1.."},{"section":"served:goal_box.header_left","slug":null,"idx":null,"text":"文言文類型","n":5,"ssz":"....."},{"section":"served:goal_box.title","slug":null,"idx":null,"text":"第12 課  不流血的戰爭","n":13,"ssz":"............."}]}
