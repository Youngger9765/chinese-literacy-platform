text":"情況變得越來越糟糕。","n":10,"ssz":"...1......"},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"蹂躪","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"任意踐踏或嚴重破壞，使事物受到傷害。","n":18,"ssz":".................."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"負成長","n":3,"ssz":"..1"},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"表示經濟或某個指標的成長率為負數，代表該項目在一段時間內數量減少了。","n":34,"ssz":"......1..2.1...........1.........."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"不容小覷","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"不能輕視或低估。","n":8,"ssz":"........"},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"長此以往","n":4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"長久像這樣持續下去，通常用來說明可能造成不好的結果。","n":26,"ssz":".........................."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"首當其衝","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"最先受到影響或承受衝擊。","n":12,"ssz":"............"},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"未雨綢繆","n":4,"ssz":"...1"},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"趁著天還沒下雨，先把門窗綁牢，比喻事先做好準備工作，以防範未然。","n":32,"ssz":"................................"},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"視而不見","n":4,"ssz":"..1."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"明明知道有事情發生，但卻故意不去注意或不去關心。","n":24,"ssz":"..............1....1...."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"他因為沉迷遊戲，荒廢課業，導致成績(　)。","n":21,"ssz":"..1.................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"村莊經過暴風雨的(　)，許多住宅殘破不堪。","n":21,"ssz":"....................."},{"section":"served:fill_in_blank[2].sent