ulary[1].word","slug":null,"idx":null,"text":"邁開","n":2,"ssz":".."},{"section":"served:vocabulary[1].definition","slug":null,"idx":null,"text":"跨步向前。","n":5,"ssz":"....."},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"計較","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"計算、比較，通常用於在意細節或小事。","n":18,"ssz":".................."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"莫名","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"說不出原因、無法解釋的感覺。","n":14,"ssz":".............."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"漣漪","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"水面上微小的波紋，也可比喻內心的細微感受或變化。","n":24,"ssz":"........................"},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"異樣","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"不一樣、和平常不同。","n":10,"ssz":".1..1....."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"靦腆","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"不好意思、害羞的樣子。","n":11,"ssz":"...2.....1."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"一如往常","n":4,"ssz":"2..."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"和以前一樣，沒有改變。","n":11,"ssz":"1..1......."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"愣","n":1,"ssz":"."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"因為驚訝、害怕或一時反應不過來，而短暫的停住或不說話、不動作。","n":31,"ssz":".1......2..11..............1..."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"他心愛的吊飾被同學弄髒，他卻一點也不（　），真是不容易。","n":28,"ssz":"..............2............."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"看著泛黃的舊照片，他的（　）飄回了在公園玩耍的童年時光。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"雖然風雨交加，交通警察還是（　）的站在路口指揮，十分敬業。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"在作品得獎後，面對大家的稱讚，她露出了（　）的笑容。","n":26,"ssz":"................1........."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"講者勵志的人生故事，在我心中起了小小的（　），也讓我更有勇氣。","n":31,"ssz":"..............................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"走在黑漆漆、空無一人的校園，他感到（　）的緊張，想趕緊離開。","n":30,"ssz":"........2....................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"幸好同學及時發現他的（　），才來得及在他暈倒前扶住他。","n":27,"ssz":"................1....1....."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"看見多年不見的老友，他開心的（　）腳步迎上前去。","n":24,"ssz":"....1..................."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列選項「　」中的語詞，何者使用正確？","n":19,"ssz":"..................."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"聽到妹妹出車禍的消息，他內心泛起「漣漪」，不知所措","n":25,"ssz":"...1....................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"他做事常常只顧自己利益，難怪很多同學都說他「靦腆」","n":25,"ssz":"........................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"平常冷漠的他，今天竟然「一如往常」的和大家打招呼","n":24,"ssz":"............2.....1....."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"他在面試時強忍著肚子痛，不想讓評審發現他的「異樣」","n":25,"ssz":".........1..............."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據第三段「我又不是那種愛計較的人，這種小事根本不值得放在心上。」這句話最可能代表什麼意思？","n":46,"ssz":"........1.................1.................2."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"作者想強調自己一點也不在意他們聊得很開心","n":20,"ssz":"....1..2..1.....1..."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"作者想說服自己不要去在意，但其實非常介意","n":20,"ssz":"...1...1............"},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"作者認為只有能夠相互計較的朋友才能夠長久","n":20,"ssz":"........1..........."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"作者認為阿葉不值得自己繼續用真心對待來往","n":20,"ssz":"........1..........."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據全文，下列哪一個選項最能解釋作者「不想對阿葉擺臭臉，更不想承認自己會因為朋友而吃醋」的原因？","n":48,"ssz":"........11...........................1.........."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"作者認為自己不該為了心上人和朋友生氣、冷戰","n":21,"ssz":"........1....1......."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"作者非常不認同阿葉的行為，認為阿葉不夠義氣","n":21,"ssz":"....1............1..."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"作者不想讓阿葉看出自己心情，怕被心上人知道","n":21,"ssz":"....................."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"作者想成全阿葉和自己喜歡的人，默默退出競爭","n":21,"ssz":".......1............."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據本文內容，關於作者的情緒變化，下列何者正確？","n":24,"ssz":"........................"},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"期待→失落→難過→驚喜→平靜","n":14,"ssz":".............."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"驚喜→失望→生氣→難過→無奈","n":14,"ssz":".............."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"驚訝→煩悶→低落→生氣→煩躁","n":14,"ssz":"....1........."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"開心→驚訝→煩躁→低落→平靜","n":14,"ssz":".............."},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"根據閱讀聚光燈的練習，下列何者對於「吃醋」的理解較為合適？","n":29,"ssz":"............................."},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"美美：常常吃醋的人通常個性小氣又愛計較，很難相處","n":24,"ssz":"......................1."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"小綠：和人相處應該保持開放心態，一旦吃醋就要檢討","n":24,"ssz":"...1.1..........1......."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"大華：吃醋代表對關係的重視和在乎，但也要避免傷人","n":24,"ssz":".............1.........."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"阿勇：如果朋友不會吃你的醋，就代表他沒有很重視你","n":24,"ssz":".......1................"},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜200字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"201~230字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞231字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（三☞）開始朗讀，計時1分鐘讀的字數，並記錄在表格中。如果你計時3次後，對自己還不滿意，可以自己多練幾次喔。最後一次，找一位同學，請他來計時、記錄並簽名！","n":88,"ssz":"...............................................................1...1...1................"},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"我盯著他們，心裡有點不是滋味。但這應該很正常吧？","n":24,"ssz":"..........1............."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"本文作者看到「朋友和自己喜歡的人聊天」，內心產生許多矛盾的想法，也發現自己在「吃醋」。「吃醋」是指當你在意的人去親近別人時，你感到不開心的情緒。如果我們不懂得怎麼面對這個情緒，就可能會用疏離、冷淡、責怪或自責的方式回應，反而讓關係受傷，也讓自己更難受。因此，學習辨認、理解和調節「吃醋」的情緒，也是成長中重要的一課，讓我們一起來看看！","n":167,"ssz":".........1....................................................................1.....1.......................1...........................1.............1....1.....2....."},{"section":"served:spotlight_v2.blocks[1].text","slug":null,"idx":null,"text":"一、辨識「吃醋」","n":8,"ssz":"........"},{"section":"served:spotlight_v2.blocks[2].prompt","slug":null,"idx":null,"text":"根據文章，作者看見朋友和喜歡的人聊得很開心後，你覺得哪些行為、情緒、反應是因為吃醋而產生的呢？（可複選，沒有標準答案，請依據你自己的想法、感受判斷）","n":74,"ssz":"...........1.....1.......1.........1..1..................................."},{"section":"served:spotlight_v2.blocks[2].options.1","slug":null,"idx":null,"text":"作者愣了一下，停下腳步，猶豫要不要走過去","n":20,"ssz":"....1..........1...."},{"section":"served:spotlight_v2.blocks[2].options.2","slug":null,"idx":null,"text":"作者深吸一口氣，轉身走回教室，假裝自己不在意","n":22,"ssz":"....2..............1.."},{"section":"served:spotlight_v2.blocks[2].options.3","slug":null,"idx":null,"text":"作者覺得胸口悶悶的，好像吞下了一顆沒嚼碎的糖果，卡在喉嚨裡","n":29,"ssz":"...1..11.......2............."},{"section":"served:spotlight_v2.blocks[2].options.4","slug":null,"idx":null,"text":"作者低下頭，假裝在看書，眼神死死盯著書頁上的字","n":23,"ssz":"......................."},{"section":"served:spotlight_v2.blocks[2].options.5","slug":null,"idx":null,"text":"作者生氣為什麼朋友那麼不貼心、為什麼自己要在意這些事","n":26,"ssz":"....1..........1.........."},{"section":"served:spotlight_v2.blocks[2].options.6","slug":null,"idx":null,"text":"作者不想回應阿葉的關心，還默默往旁邊挪了一點，遠離阿葉","n":27,"ssz":".....1..............2......"},{"section":"served:spotlight_v2.blocks[2].answer_carrier","slug":null,"idx":null,"text":"題目明寫「沒有標準答案」，學生自填；原稿無勾選","n":23,"ssz":"......................."},{"section":"served:spotlight_v2.blocks[3].prompt","slug":null,"idx":null,"text":"下列哪些情境你會「吃醋」？（可複選）","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[3].options.1","slug":null,"idx":null,"text":"想和他一起完成的事，他卻先找別人了。","n":18,"ssz":".1.2.............."},{"section":"served:spotlight_v2.blocks[3].options.2","slug":null,"idx":null,"text":"他有心事不告訴我，卻和別的同學分享。","n":18,"ssz":"....1.....1......."},{"section":"served:spotlight_v2.blocks[3].options.3","slug":null,"idx":null,"text":"他下課就只會打球，也不找我聊天。","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[3].options.4","slug":null,"idx":null,"text":"他很少發動態，但發了和別人一起出去玩的照片。","n":22,"ssz":"..........1..2........"},{"section":"served:spotlight_v2.blocks[3].options.5","slug":null,"idx":null,"text":"他和別人有一些我無法參與的共同話題和小默契。","n":22,"ssz":".1...2.....1.....1...."},{"section":"served:spotlight_v2.blocks[3].options.6","slug":null,"idx":null,"text":"明明你也有努力和付出，但他只稱讚別人。","n":19,"ssz":".......1..........."},{"section":"served:spotlight_v2.blocks[3].answer_carrier","slug":null,"idx":null,"text":"學生自填，原稿無勾選","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[4].prompt","slug":null,"idx":null,"text":"※吃醋可能混合多種情緒，請從下列中選出你有過的感覺：（可複選）","n":31,"ssz":"................1.............."},{"section":"served:spotlight_v2.blocks[4].options.1","slug":null,"idx":null,"text":"生氣","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.2","slug":null,"idx":null,"text":"難過","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.3","slug":null,"idx":null,"text":"羞愧","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.4","slug":null,"idx":null,"text":"失落","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.5","slug":null,"idx":null,"text":"焦慮","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.6","slug":null,"idx":null,"text":"不甘心","n":3,"ssz":"..."},{"section":"served:spotlight_v2.blocks[4].options.7","slug":null,"idx":null,"text":"想哭","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.8","slug":null,"idx":null,"text":"羨慕","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.9","slug":null,"idx":null,"text":"嫉妒","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].options.10","slug":null,"idx":null,"text":"討厭對方","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[4].options.11","slug":null,"idx":null,"text":"想裝沒事","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[4].options.12","slug":null,"idx":null,"text":"悶悶的","n":3,"ssz":"11."},{"section":"served:spotlight_v2.blocks[5].text","slug":null,"idx":null,"text":"二、理解「吃醋」：吃醋的原因大概可以分為以下四種──","n":26,"ssz":".........................."},{"section":"served:spotlight_v2.blocks[6].columns[0]","slug":null,"idx":null,"text":"成因類型","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[6].columns[1]","slug":null,"idx":null,"text":"說明","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[6].columns[2]","slug":null,"idx":null,"text":"舉例","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[6].rows[0][0]","slug":null,"idx":null,"text":"1.被忽略或被排除的感覺","n":12,"ssz":"............"},{"section":"served:spotlight_v2.blocks[6].rows[0][1]","slug":null,"idx":null,"text":"覺得自己不再是他的第一順位。","n":14,"ssz":".1..1........."},{"section":"served:spotlight_v2.blocks[6].rows[0][2]","slug":null,"idx":null,"text":"好友下課沒來找你，卻和其他人一起走。","n":18,"ssz":"..........1...2..."},{"section":"served:spotlight_v2.blocks[6].rows[1][0]","slug":null,"idx":null,"text":"2.對關係的不安全感","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[6].rows[1][1]","slug":null,"idx":null,"text":"擔心朋友或喜歡的人對你的感情改變了。","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[6].rows[1][2]","slug":null,"idx":null,"text":"他最近常和別人聊天，跟我說話越來越少。","n":19,"ssz":"....1.............."},{"section":"served:spotlight_v2.blocks[6].rows[2][0]","slug":null,"idx":null,"text":"3.「和別人比較」引起","n":11,"ssz":"...1......."},{"section":"served:spotlight_v2.blocks[6].rows[2][1]","slug":null,"idx":null,"text":"覺得他對別人比較好，而你「輸了」。","n":17,"ssz":".1..............."},{"section":"served:spotlight_v2.blocks[6].rows[2][2]","slug":null,"idx":null,"text":"朋友在群組只回別人訊息，沒回你。","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[6].rows[3][0]","slug":null,"idx":null,"text":"4.內心期望沒被滿足","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[6].rows[3][1]","slug":null,"idx":null,"text":"你希望他主動、靠近你，但他沒那麼做。","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[6].rows[3][2]","slug":null,"idx":null,"text":"你以為他知道你想一起吃午餐，結果他沒找你。","n":21,"ssz":"........2............"},{"section":"served:spotlight_v2.blocks[7].prompt","slug":null,"idx":null,"text":"※你覺得你自己比較常因為哪些原因吃醋呢？","n":20,"ssz":"...1.......1........"},{"section":"served:spotlight_v2.blocks[7].options.1","slug":null,"idx":null,"text":"被忽略或被排除的感覺","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[7].options.2","slug":null,"idx":null,"text":"對關係的不安全感","n":8,"ssz":"........"},{"section":"served:spotlight_v2.blocks[7].options.3","slug":null,"idx":null,"text":"「和別人比較」引起","n":9,"ssz":".1......."},{"section":"served:spotlight_v2.blocks[7].options.4","slug":null,"idx":null,"text":"內心期望沒被滿足","n":8,"ssz":"........"},{"section":"served:spotlight_v2.blocks[8].text","slug":null,"idx":null,"text":"三、調節情緒：6A策略──覺察（Aware）、承認（Acknowledge）、允許（Allow）、接納（Accept）、轉化（Action）、欣賞（Appreciate）","n":85,"ssz":"....................................................................................."},{"section":"served:spotlight_v2.blocks[9].columns[0]","slug":null,"idx":null,"text":"6A策略","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[9].columns[1]","slug":null,"idx":null,"text":"實際演練","n":4,"ssz":"...."},{"section":"served:spo