ug":null,"idx":null,"text":"下列文句，何者語詞使用最恰當？","n":15,"ssz":"..............."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"這裡風光明媚，是「杳無人煙」的旅遊勝地","n":19,"ssz":"..................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"這部電影有許多令人「驚心動魄」的火爆場面，超級可怕","n":25,"ssz":"........................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"這個道士學藝不精，破綻百出，真是「回天乏術」","n":22,"ssz":".1...................."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"做事應用「譁眾取寵」的態度，博取流量及曝光度","n":22,"ssz":"..1..................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據作者的說法，為什麼含光可以擊退老虎、救回弟弟？","n":25,"ssz":"........1..............1."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"因為含光有道士的即時幫忙和提醒","n":15,"ssz":".1..........1.."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"老虎可能身體狀態不佳，不敵人類","n":15,"ssz":"..............."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"因為含光是百年難得一見的大力士","n":15,"ssz":".1.......1....."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"含光不怕死的吮吸弟弟傷口的毒血","n":15,"ssz":"..1......1....."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據本課內容，何者敘述為真？","n":14,"ssz":".............."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"故事發生的地點是人跡眾多地方","n":14,"ssz":".............."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"弟弟受傷過重，從頭到尾未甦醒","n":14,"ssz":".1............"},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"含光為救弟弟，不顧自身的安全","n":14,"ssz":".....1.1......"},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"故事中的老虎敏捷迅速、很強壯","n":14,"ssz":".............."},{"section":"served:multiple_choice[2].explanation","slug":null,"idx":null,"text":"(用自己的嘴巴吸出毒素，不怕中毒)","n":17,"ssz":"............1.1.."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"請問這篇文章中，作者（曾世杰）最想傳達什麼理念給讀者？","n":27,"ssz":"..........................."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"對任何事情都要保持先懷疑，後求證的態度","n":19,"ssz":"..................."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"批判古人在記載故事都十分潦草、不求謹慎","n":19,"ssz":"..................."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"宣揚兄弟友愛的理念，互助合作來打退猛虎","n":19,"ssz":"..................."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"宣傳在野外被動物咬傷時，正確的急救方式","n":19,"ssz":"..................."},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"這篇文章示範了一種閱讀態度，請選出底下最接近的描述？","n":26,"ssz":".......2.................."},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"文字紀錄是可靠的，隔了350年仍然可信","n":19,"ssz":"..................."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"閱讀時應該全然信任作者","n":11,"ssz":"..........."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"閱讀時可以提出質疑，並蒐集資料","n":15,"ssz":"..............."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"閱讀時寧願相信書，而不要相信網路","n":16,"ssz":".....1....1.1..."},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜220字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"221~250字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].thr