},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"精湛","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"形容技術或能力非常高明，做得又好又準。","n":19,"ssz":".............1....."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"綿延","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"形容事物連續不斷的延伸，很長、很久都沒有中斷；常用來描述長度或時間。","n":34,"ssz":"......1..........................."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"星羅棋布","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"形容事物分散在各處，數量很多，到處都有。","n":20,"ssz":"........1.......1..."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"舉足輕重","n":4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"形容某件事或某個角色非常重要，會影響整個情況。","n":23,"ssz":".......11..........1..."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"掛一漏萬","n":4,"ssz":".1.."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"漏：遺漏。形容只提到一小部分，卻遺漏了非常多重要內容。","n":27,"ssz":"..........2..1........1...."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"支離破碎","n":4,"ssz":"...."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"零散又破裂。形容內容零散、不完整，前後連不起來。","n":24,"ssz":"........................"},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"一目了然","n":4,"ssz":"...."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"目：眼睛；了然：清楚明白。形容事情或結果非常清楚，看一眼就懂，不需要再解釋。","n":38,"ssz":"..........................2..........."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"從飛機上往下看台北市，街燈（　），整個城市看起來閃閃發亮。","n":29,"ssz":"..................1.........."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"放眼望去，山脈一座接著一座，(　)到遠方，看不到盡頭。","n":27,"ssz":".......1...1..........1..