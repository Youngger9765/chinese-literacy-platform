":"served:vocabulary[2].word","slug":null,"idx":null,"text":"萬頭鑽動","n":4,"ssz":"...."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"形容很多人或動物擠在一起移動的樣子。","n":18,"ssz":"..........2.....1."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"本能","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"不用學就會的反應或行為。","n":12,"ssz":"1......1...."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"承載","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"承受或運送人、物，也可指包含情感、責任等抽象事物。","n":25,"ssz":"........................."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"暢行無阻","n":4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"順利通行，沒有阻礙。","n":10,"ssz":".........."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"與生俱來","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"出生時就已具備的，天生的。","n":13,"ssz":"............."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"契機","n":2,"ssz":".."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"讓事情開始、改變或發展的關鍵機會。","n":17,"ssz":"................."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"棲息地","n":3,"ssz":"..."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"動植物生長、生活的自然環境。","n":14,"ssz":"....1........."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"閘門","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"設在水道中，可以升降或開合，用來控制水流的裝置。","n":24,"ssz":"........................"},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"滯留","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"停留在某處，無法離開或繼續前進。","n":16,"ssz":"................"},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"這座老橋已無法（　）大量車輛的重量。","n":18,"ssz":".................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"砍伐森林會破壞許多生物的（　），使牠們失去生存的地方。","n":27,"ssz":"..........................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"他因颱風（　）在機場兩天，無法返家。","n":18,"ssz":".................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"半導體產業在臺灣經濟中十分重要，可說是臺灣經濟的（　）。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"他展現出（　）的節奏感，即使沒學過打鼓，也能輕鬆跟上節拍。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"演唱會開場前，大巨蛋外已經（　），密密麻麻的人潮擠滿四周。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"有了通行證後，他們便能（　）的進出原本禁止通行的管制區。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"那次運動會的成功經驗成為他全心投入田徑競技的重要（　）。","n":28,"ssz":"............................"},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列哪一個句子中，語詞的使用錯誤？","n":17,"ssz":"....1.1.........."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"海邊擠滿了遊客，放眼望去真是「萬頭鑽動」，十分熱鬧","n":25,"ssz":"........................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"這條街道拓寬整修後變得「暢行無阻」，再也不會塞車了","n":25,"ssz":"..........1.........1...."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"公車每天要「承載」大量乘客，因此需要定期檢查保養","n":24,"ssz":"........................"},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"他經過長時間練習，終於培養出「與生俱來」的節奏感","n":24,"ssz":"........................"},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"文中提到「代表魚兒塞車了」，「魚兒塞車」是指什麼情況？","n":27,"ssz":"........1.......1.........."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"大量魚群擠在閘門前進退兩難","n":13,"ssz":"............."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"魚群像汽車一樣排成一直線前進","n":14,"ssz":".....1...2...."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"魚群游到閘門前因害怕而停下來","n":14,"ssz":".............."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"魚群因數量太多，在水中移動緩慢","n":15,"ssz":"..............."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"文章標題和結尾都重複出現「叮咚叮咚」，作者這樣安排有何用意？","n":30,"ssz":"....1...1....................."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"暗示裝置的聲音特別，凸顯魚門鈴設計的新穎創意","n":22,"ssz":"......................"},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"用門鈴意象說明網站功能，讓讀者了解按鈴後會開閘","n":23,"ssz":"...............1......."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"用門鈴首尾呼應，邀請讀者以有創意的方式參與關心生態保育","n":27,"ssz":"......1.............1......"},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"透過聲音營造輕快感，讓讀者感覺文章讀起來順暢","n":22,"ssz":"......................"},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"本文的主旨是什麼？","n":9,"ssz":"........."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"強調興建堤防、水閘對環境的危害，呼籲拆除多餘的水閘設施","n":27,"ssz":".1........................."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"介紹荷蘭人如何以創意幫助魚群洄游、並讓人們可以參與保育","n":27,"ssz":"........................1.."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"說明荷蘭運河的歷史與功能，展現人類水利工程的智慧成果","n":26,"ssz":".........................."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"討論魚類洄游的習性與面臨的挑戰，提醒大眾關注水域生態","n":26,"ssz"