,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"接連不斷的樣子。","n":8,"ssz":"..1...1."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"渲染","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"用色彩、光線或文字，營造出某種氣氛或感覺。也比喻言詞、文字過度誇大。","n":34,"ssz":".................................."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"漸行漸遠","n":4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"慢慢的越走越遠。也可以形容方向、關係越來越疏離。","n":24,"ssz":"........................"},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"暈黃","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"帶著淡淡黃色、柔和不明亮的光。暈，光影、色澤四周模糊的樣子。","n":30,"ssz":"............................1."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"剛出爐的肉包(　)的樣子，看得我口水直流。","n":21,"ssz":"...........1..1......"},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"煙火在空中(　)綻放，天空好像開滿了一朵又一朵的花。","n":26,"ssz":"..................2..2...."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"這位畫家用漸層的色彩來(　)天空，讓整幅畫看起來更加夢幻。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"自從小學畢業後，他們的聯絡越來越少，因此關係也(　)了。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"當志明說：「春嬌這麼美，這麼好，是不可能看上我的。」志明的(　)是他好希望春嬌可以喜歡他。","n":45,"ssz":"............................................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"親戚遠道而來，爸爸熱情(　)他們，請他們品嘗家鄉的美食。","n":28,"ssz":"........1..................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"冬天的寒風吹個不停，等公車的人們一邊(　)，一邊縮著身子取暖。","n":31,"ssz":"................2.....2....1..."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"傍晚時分，路燈散發出(　)的光芒，讓街道多了一分溫暖。","n":27,"ssz":"......................2...."},{"section":"served:vocab_bank.H","slug":null,"idx":null,"text":"招待","n":2,"ssz":".."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列選項「　」中的語詞，何者使用正確？","n":19,"ssz":"..................."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"小夫捉弄胖虎，胖虎氣炸了，「熱氣騰騰」的跑去找他算帳","n":26,"ssz":".........................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"他們因為觀念相差太多，最終感情「漸行漸遠」，離婚收場","n":26,"ssz":"...1..1..................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"晚飯時間，我的爸爸下班後「陸續」離開公司回來了","n":23,"ssz":"........1.............."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"開學前他去把頭髮「渲染」成金色，希望吸引大家的目光","n":25,"ssz":"........................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據本文，下列哪一個線索，主要是在表現老人想讓孫子安心吃麵？","n":30,"ssz":".........1..............1....."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"老人家摸摸自己的肚子，對孫子說自己飽的像蜘蛛","n":22,"ssz":".........1...1........"},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"老人家在社區做資源回收，提著裝了回收物的垃圾袋","n":23,"ssz":"......................."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"老人家看菜單，數一數手中零錢，點最便宜的陽春麵","n":23,"ssz":".......1.........1....."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"老人家只點一碗麵給孫子吃，自己只是拚命喝水","n":21,"ssz":".....2....1.........."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據第三段，老阿公真的是第一百個客人嗎？為什麼老闆要這麼說？","n":30,"ssz":"....................1........."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"是，因為這是他們店裡新的促銷活動，阿公正好是幸運兒","n":25,"ssz":"...1....................."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"是，因為他是店裡第一百個客人，所以免費得到一碗麵","n":24,"ssz":"...1.................2.."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"不是，因為老闆根本沒算人數，他只想快點賣完回家休息","n":25,"ssz":"1...1...................."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"不是，因為老闆看出祖孫生活不寬裕，想幫忙他們","n":22,"ssz":"1...1................."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據第三段內容，為什麼老人要跟小男孩說他飽的像蜘蛛一樣？","n":28,"ssz":"........1................1.."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"因為他有啤酒肚，看起來像蜘蛛","n":14,"ssz":".1............"},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"他剛剛有吃其他東西，真的很飽","n":14,"ssz":".............."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"他想開玩笑讓吃飯氛圍更開心","n":13,"ssz":"............."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"他想用玩笑來化解孫子的擔心","n":13,"ssz":".........1..."},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"根據本文，老闆最後說小男孩正在學習「不吃東西也會飽」的道理，請問這個道理是什麼意思呢？","n":43,"ssz":".................................1......2.."},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"這是一種鍛鍊意志力的方法","n":12,"ssz":"..2........."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"這是運用想像力讓自己度過難關的練習","n":17,"ssz":"................."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"這是為重要的人付出，心裡也會感到滿足","n":18,"ssz":".................."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"這是一種新的飲食型態，斷食久了就會習慣","n":19,"ssz":"..2................"},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜190字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"191~220字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞221字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（四☞）開始朗讀，計時1分鐘讀的字數，並記錄在表格中。如果你計時3次後，對自己還不滿意，可以自己多練幾次喔。最後一次，找一位同學，請他來計時、記錄並簽名！","n":88,"ssz":"...............................................................1.......1................"},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.benchmark_label","slug":null,"idx":null,"text":"◎ 我的表現","n":6,"ssz":"......"},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"寒流來襲那天，老闆又看見了小男孩。他守在攤子旁邊","n":24,"ssz":".....................1.."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"「換位思考」是站在別人的角度看事情，試著理解對方的處境、想法與感受。故事中的阿公、小男孩或是麵攤老闆，他們都能夠換位思考，懂得替別人著想。\n我們可以用三個步驟來學習「換位思考」喔：\n(1)觀察言行：看對方說了什麼、做了什麼。\n(2)推論動機：根據(1)的觀察，想想他為什麼這樣說或這樣做。\n(3)成功換位思考：綜合(2)的推論，站在他的角度，推想他可能的想法、感受或需要。\n接下來我們要用「換位思考三步驟」，來練習推論出本篇故事中人物說話或行為的動機，以及言外之意喔！","n":234,"ssz":"..............................................................1...3.........1........................................................1..................................................................................................1."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"「換位思考」是站在別人的角度看事情，試著理解對方的處境、想法與感受。故事中的阿公、小男孩或是麵攤老闆，他們都能夠換位思考，懂得替別人著想。","n":69,"ssz":"..............................................................1...3.."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"我們可以用三個步驟來學習「換位思考」喔：","n":20,"ssz":"......1............."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"(1)觀察言行：看對方說了什麼、做了什麼。","n":21,"ssz":"....................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"(2)推論動機：根據(1)的觀察，想想他為什麼這樣說或這樣做。","n":31,"ssz":"....................1.........."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"(3)成功換位思考：綜合(2)的推論，站在他的角度，推想他可能的想法、感受或需要。","n":41,"ssz":"........................................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"接下來我們要用「換位思考三步驟」，來練習推論出本篇故事中人物說話或行為的動機，以及言外之意喔！","n":47,"ssz":".............................................1."},{"section":"served:spotlight_v2.blocks[1].text","slug":null,"idx":null,"text":"◎小試身手","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[2].label","slug":null,"idx":null,"text":"1.（阿公的想法）","n":9,"ssz":"........."},{"section":"served:spotlight_v2.blocks[2].instruction","slug":null,"idx":null,"text":"我們要利用換位思考三步驟來推論課文中阿公的想法，請根據阿公說的話或行為想一想、連連看，做出合理的推論。","n":51,"ssz":"..................................................."},{"section":"served:spotlight_v2.blocks[2].left_header","slug":null,"idx":null,"text":"步驟一：觀察言行","n":8,"ssz":"........"},{"section":"served:spotlight_v2.blocks[2].right_header","slug":null,"idx":null,"text":"步驟二：推論動機","n":8,"ssz":"........"},{"section":"served:spotlight_v2.blocks[2].left.1","slug":null,"idx":null,"text":"老人看攤位的菜單，數手裡的零錢，點了一碗最便宜的陽春麵。","n":28,"ssz":"..................2..1......"},{"section":"served:spotlight_v2.blocks[2].left.2","slug":null,"idx":null,"text":"老人從袋子裡緩緩拿出瓶子，喝了口水，摸自己的肚子。","n":25,"ssz":"....1......1...........1."},{"section":"served:spotlight_v2.blocks[2].left.3","slug":null,"idx":null,"text":"阿公說：「真的啊，飽得像蜘蛛一樣。」誇張的動作和語言，讓祖孫倆都笑了起來。","n":37,"ssz":"..........1...1........1............."},{"section":"served:spotlight_v2.blocks[2].right.A","slug":null,"idx":null,"text":"可能是藉由這樣的方式填飽肚子。","n":15,"ssz":".............1."},{"section":"served:spotlight_v2.blocks[2].right.B","slug":null,"idx":null,"text":"用開玩笑的方式讓孫子放心吃麵。","n":15,"ssz":".........1....."},{"section":"served:spotlight_v2.blocks[2].right.C","slug":null,"idx":null,"text":"阿公的錢應該不夠多。","n":10,"ssz":"......1..."},{"section":"served:spotlight_v2.blocks[2].answer_carrier","slug":null,"idx":null,"text":"連線（圖形）；此題教師版未畫線，無答案可轉錄","n":22,"ssz":"......................"},{"section":"served:spotlight_v2.blocks[3].label","slug":null,"idx":null,"text":"步驟三：成功換位思考（阿公）","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[3].stem","slug":null,"idx":null,"text":"→阿公應該【 還沒 / 已經 】吃飽，用這麼誇張的方式說話是因為錢不夠，又想讓孫子【 安心/放心 】吃麵。","n":53,"ssz":"...............................1.1......1............"},{"section":"served:spotlight_v2.blocks[3].selected","slug":null,"idx":null,"text":"還沒","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[3].blanks[0].answer","slug":null,"idx":null,"text":"安心/放心","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[3].answer_carrier","slug":null,"idx":null,"text":"橘色方框圈住「還沒」；「安心/放心」為橘色手寫參考答案","n":27,"ssz":"..........................."},{"section":"served:spotlight_v2.blocks[4].label","slug":null,"idx":null,"text":"2.進階題（老闆的想法）","n":12,"ssz":"............"},{"section":"served:spotlight_v2.blocks[4].instruction","slug":null,"idx":null,"text":"我們要再利用換位思考三步驟來推論課文中老闆的想法，請根據老闆說的話或行為想一想、連連看，做出合理的推論。","n":52,"ssz":".....