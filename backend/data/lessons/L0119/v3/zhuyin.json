l,"idx":null,"text":"看見他滿面春風，令我不禁（　）他是否有了新戀情。","n":24,"ssz":"...........1............"},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"由於違反當地法律，幾名外國遊客被（　）回國。","n":22,"ssz":"......................"},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"好朋友即將出國留學，我們約在餐廳為她（　）。","n":22,"ssz":"................1....."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列語詞何者使用正確？","n":11,"ssz":"..........."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"學生在操場上追逐嬉戲，「呢喃」的笑聲傳遍校園","n":22,"ssz":"............1........."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"十年同學會上，大家期待著與昔日同窗的「邂逅」","n":22,"ssz":"......................"},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"儘管面臨挑戰，公司仍堅持「一貫」的環保信念","n":21,"ssz":".............1......."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"年邁的夫妻「佇足」在公園的長椅上，看著夕陽","n":21,"ssz":"....................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"第一段「我是風塵僕僕的考生，緊湊的腳步踩著不容錯過的時刻」，請問最可能是下列何種情境？","n":43,"ssz":"..........................................."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"作者考試項目是跳舞，必須踏準節拍","n":16,"ssz":"................"},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"作者於風沙中行走，需抖落鞋中的沙","n":16,"ssz":"................"},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"作者已遲到許久，因此必須加快腳程","n":16,"ssz":"................"},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"作者行程緊湊，腳步匆忙，深怕耽擱","n":16,"ssz":"................"},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"下列文句的解讀何者正確？","n":12,"ssz":"............"},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"「台北的天空被建築擠得破碎」──台北的高樓遮蔽了天