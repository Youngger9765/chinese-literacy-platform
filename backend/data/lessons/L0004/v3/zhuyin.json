ll,"text":"一言一行","n":4,"ssz":"..2."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"說的每句話、做的每件事；常用來形容行為表現的細節。","n":25,"ssz":"........................."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"偵測","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"查看有沒有出現某種情況。","n":12,"ssz":"............"},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"雀躍","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"像麻雀輕快地跳躍；形容心情輕快愉悅。","n":18,"ssz":".................."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"這次總統大選競爭激烈，記者們都密切注意選舉的（　）。","n":26,"ssz":"................1........."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"看到自己努力畫的作品被老師認為是抄襲，小偉心裡真的很（　）。","n":30,"ssz":".............................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"那天比賽失誤的畫面一直（　），讓她晚上翻來覆去睡不著。","n":27,"ssz":".........2................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"經過真誠的溝通後，原本的誤會像（　）般消失了，兩人終於和好。","n":30,"ssz":".............................."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"被喜歡的同學加好友後，她（　），笑得好開心。","n":22,"ssz":".................1...."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"這部電影的劇情充滿（　）轉折，觀眾的情緒也隨著角色的命運緊張不已。","n":33,"ssz":".......................1........."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"身為班長，他深知自己的（　）都會影響同學，因此更加謹言慎行。","n":30,"ssz":"...1.........................."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"幸好他及時尋求幫助，他才沒有一步步走向憂鬱的（　）。","n":26,"ssz":"..............1..........."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列選項「  」中的語詞，何者使用正確？","n":20,"ssz":"...................."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"經過多年的努力，他終於打破紀錄，攀上了「深淵」","n":23,"ssz":"......................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"美國暫緩提升關稅後，大家都密切關注市場「動向」","n":23,"ssz":"..............1........"},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"春天已經悄悄來臨，時不時都能看見路邊「心花怒放」","n":24,"ssz":"........................"},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"他對公司「揮之不去」，儘管時常加班，他也無怨無尤","n":24,"ssz":".......1................"},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據第三段，「（這些念頭）像是一群停不下來的蜜蜂，在腦袋裡嗡嗡作響」這句話最可能表現出作者當時的什麼狀態？","n":53,"ssz":"..................1.................................."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"手足無措，對於未來感到一片茫然","n":15,"ssz":"..............."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"活力四射，腦海中有大量靈感出現","n":15,"ssz":"..............."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"煩亂不堪，無法停止各種胡思亂想","n":15,"ssz":"..............."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"緊張無比，深怕自己做錯了什麼事","n":15,"ssz":"..............."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據文章結尾「也許只要他再對我笑一次，這些煩惱又會立刻煙消雲散吧。」下列選項何者最貼近這句話的背後意涵？","n":52,"ssz":"...................................................."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"強調任何煩惱都該要用微笑面對","n":14,"ssz":".1............"},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"強調煩惱像煙霧消散，不用掛心","n":14,"ssz":".1........1..."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"強調已準備放下對方，一笑置之","n":14,"ssz":".1........1..."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"強調對方對自己的情緒影響極大","n":14,"ssz":".1............"},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據本文標題「喜歡是什麼」及內容，下列敘述何者最貼近作者答案？","n":31,"ssz":"..............................."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"喜歡是颱風來臨時的海浪，高高低低，且難以控制","n":22,"ssz":"......................"},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"喜歡是大雨過後的彩虹，繽紛美好，卻也無法久留","n":22,"ssz":"......................"},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"喜歡是遲遲無法擺脫的惡夢，時刻相伴，無處可逃","n":22,"ssz":"...............1...1.."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"喜歡是童年時的糖果，讓人滿口都甜蜜，心情愉快","n":22,"ssz":"......................"},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"根據品格聚光燈的練習，下列何者對於「事件─想法─感受」的理解較為合適？","n":35,"ssz":"..................................."},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"橘子：每個人在相同的事件中都有相同的感受","n":20,"ssz":".1..1..1.......1...."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"步美：比起想法，事件對感受的影響更為直接","n":20,"ssz":"...................."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"靜香：越快對事件下判斷就越能保持平靜喜悅","n":20,"ssz":"...................."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"小葵：釐清對事件的想法有助於自己調適心情","n":20,"ssz":"...................."},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜190字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"191~220字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞221字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（三☞）開始朗讀，計時1分鐘讀的字數，並記錄在表格中。如果你計時3次後，對自己還不滿意，可以自己多練幾次喔。最後一次，找一位同學，請他來計時、記錄並簽名！","n":88,"ssz":"...............................................................1.......1................"},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.benchmark_label","slug":null,"idx":null,"text":"◎ 我的表現","n":6,"ssz":"......"},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"然而最近我更發現當他和其他同學聊天聊得很開心，我","n":24,"ssz":"..........1.......1....."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"本文作者看到「朋友和別人聊天」，會不開心；但很多人會覺得這根本沒什麼。為什麼同一件事，不同人會有不同的情緒感受？\n情緒常受到兩件事影響：一、遭遇的事件本身，二、我們「怎麼想這件事」。也就是說，你有情緒時，你的情緒也許是「想法」造成的。底下的練習，讓我們來學著覺察「想法和情緒間的關係」。","n":143,"ssz":".........1.................1.......1..................................................................................................1........"},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"本文作者看到「朋友和別人聊天」，會不開心；但很多人會覺得這根本沒什麼。為什麼同一件事，不同人會有不同的情緒感受？","n":56,"ssz":".........1.................1.......1...................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"情緒常受到兩件事影響：一、遭遇的事件本身，二、我們「怎麼想這件事」。也就是說，你有情緒時，你的情緒也許是「想法」造成的。底下的練習，讓我們來學著覺察「想法和情緒間的關係」。","n":86,"ssz":".............................................................................1........"},{"section":"served:spotlight_v2.blocks[1].label","slug":null,"idx":null,"text":"小試身手（第一張表）","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[1].instruction","slug":null,"idx":null,"text":"◎小試身手：(沒有標準答案，請依據你自己的想法、感受判斷)","n":29,"ssz":"............................."},{"section":"served:spotlight_v2.blocks[1].columns[0]","slug":null,"idx":null,"text":"事件","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[1].columns[1]","slug":null,"idx":null,"text":"背後可能的想法（單選）","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[1].columns[2]","slug":null,"idx":null,"text":"情緒感受","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[1].answer_carrier","slug":null,"idx":null,"text":"紅色 ☑（圖形），文字流無此資訊","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[1].items[0].event","slug":null,"idx":null,"text":"看見喜歡的人與別人談笑","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[1].items[0].options.1","slug":null,"idx":null,"text":"我沒有那個人幽默風趣","n":10,"ssz":"....1....."},{"section":"served:spotlight_v2.blocks[1].items[0].options.2","slug":null,"idx":null,"text":"他真棒，能和這麼多人打成一片","n":14,"ssz":".....1........"},{"section":"served:spotlight_v2.blocks[1].items[1].event","slug":null,"idx":null,"text":"他（喜歡的人）下課沒有來找我","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[1].items[1].options.1","slug":null,"idx":null,"text":"我是不是沒那麼重要？","n":10,"ssz":"..1......."},{"section":"served:spotlight_v2.blocks[1].items[1].options.2","slug":null,"idx":null,"text":"今天他另有重要的事要做","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[1].items[1].emotion","slug":null,"idx":null,"text":"沮喪失落","n":4,"ssz":".1.."},{"section":"served:spotlight_v2.blocks[1].items[2].event","slug":null,"idx":null,"text":"下課時和喜歡的人說到話或對到眼","n":15,"ssz":"...1..........."},{"section":"served:spotlight_v2.blocks[1].items[2].options.1","slug":null,"idx":null,"text":"對他來說，我一定不只是普通同學","n":15,"ssz":"......1........"},{"section":"served:spotlight_v2.blocks[1].items[2].options.2","slug":null,"idx":null,"text":"我可以繼續觀察我們的關係變化","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[1].items[2].emotion","slug":null,"idx":null,"text":"雀躍欣喜","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[2].text","slug":null,"idx":null,"text":"☆勾完後，再看看沒有勾選的選項，那樣的想法所帶來的情緒有什麼不同呢？","n":34,"ssz":".................................."},{"section":"served:spotlight_v2.blocks[3].label","slug":null,"idx":null,"text":"更多情境事件（第二張表）","n":12,"ssz":"............"},{"section":"served:spotlight_v2.blocks[3].instruction","slug":null,"idx":null,"text":"◎接著，我們再來看看更多情境事件，並根據題目的情緒，選擇對應的想法。","n":34,"ssz":"......................2......1...."},{"section":"served:spotlight_v2.blocks[3].items[0].event","slug":null,"idx":null,"text":"上課舉手發言，結果被老師糾正錯誤","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[3].items[0].options.1","slug":null,"idx":null,"text":"天啊！大家一定覺得我愛現又很蠢","n":15,"ssz":".....1..1......"},{"section":"served:spotlight_v2.blocks[3].items[0].options.2","slug":null,"idx":null,"text":"幸好我有發言，才能得到老師的糾正","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[3].items[0].emotion","slug":null,"idx":null,"text":"踏實、感謝","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[3].items[1].event","slug":null,"idx":null,"text":"傳訊息問朋友作業，被未讀未回","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[3].items[1].options.1","slug":null,"idx":null,"text":"他可能嫌我太煩、太笨所以不想回","n":15,"ssz":"..............."},{"section":"served:spotlight_v2.blocks[3].items[1].options.2","slug":null,"idx":null,"text":"他可能在忙，我先問問看其他人","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[3].items[1].emotion","slug":null,"idx":null,"text":"焦慮、失落","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[3].items[2].event","slug":null,"idx":null,"text":"放學的時候，朋友沒等我一起走","n":14,"ssz":"...........2.."},{"section":"served:spotlight_v2.blocks[3].items[2].options.1","slug":null,"idx":null,"text":"他今天是不是有什麼急事呢？","n":13,"ssz":"....1........"},{"section":"served:spotlight_v2.blocks[3].items[2].options.2","slug":null,"idx":null,"text":"是我做錯了什麼嗎？他想刻意避開我","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[3].items[2].emotion","slug":null,"idx":null,"text":"平靜、好奇","n":5,"ssz":"...1."},{"section":"served:spotlight_v2.blocks[3].items[3].event","slug":null,"idx":null,"text":"同學在群組約大家看電影，沒有標註我","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[3].items[3].options.1","slug":null,"idx":null,"text":"他們可能以為我一定會去了","n":12,"ssz":".......1...."},{"section":"served:spotlight_v2.blocks[3].items[3].options.2","slug":null,"idx":null,"text":"他們是不是想排擠我？故意針對我？","n":16,"ssz":"...1............"},{"section":"served:spotlight_v2.blocks[3].items[3].emotion","slug":null,"idx":null,"text":"傷心、憤怒","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[3].items[4].event","slug":null,"idx":null,"text":"同學主動幫我處理老師交代的任務","n":15,"ssz":"..............."},{"section":"served:spotlight_v2.blocks[3].items[4].options.1","slug":null,"idx":null,"text":"同學好熱心，也為我省下了不少時間","n":16,"ssz":".......1........"},{"section":"served:spotlight_v2.blocks[3].items[4].options.2","slug":null,"idx":null,"text":"他好瞧不起我，不相信我可以做好","n":15,"ssz":"........1......"},{"section":"served:spotlight_v2.blocks[3].items[4].emotion","slug":null,"idx":null,"text":"開心、溫暖","n":5,"ssz":"....."},{"section":"served:spotlight_v2.blocks[4].label","slug":null,"idx":null,"text":"歸納","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].prompt","slug":null,"idx":null,"text":"◎根據上面的回答，請試著歸納，能帶來平靜、好心情的想法多半具備下列哪些特質呢？","n":39,"ssz":"......................................."},{"section":"served:spotlight_v2.blocks[4].options.1","slug":null,"idx":null,"text":"能換位思考，願意站在他人立場理解行為","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[4].options.2","slug":null,"idx":null,"text":"願意接受事情有很多種可能，不針對自己","n":18,"ssz":".................."},{"section":"served:spotlight_v2.blocks[4].options.3","slug":null,"idx":null,"text":"自我中心，凡事只相信自己的判斷","n":15,"ssz":"........1......"},{"section":"served:spotlight_v2.blocks[4].options.4","slug":null,"idx":null,"text":"能從善意的角度解釋他人行為","n":13,"ssz":"............."},{"section":"served:spotlight_v2.blocks[4].options.5","slug":null,"idx":null,"text":"能保持好奇，不急著下判斷","n":12,"ssz":"...1........"},{"section":"served:spotlight_v2.blocks[4].options.6","slug":null,"idx":null,"text":"過度連結，認為許多事情都是自己的責任、都跟自己有關","n":25,"ssz":"........................."},{"section":"served:spotlight_v2.blocks[4].options.7","slug":null,"idx":null,"text":"能看見自己的優點，不隨意否定自己","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[4].option_examples.1","slug":null,"idx":null,"text":"（如：他放學沒等我，可能是剛好跟家人有約，來不及說。）","n":27,"ssz":"..........................."},{"section":"served:spotlight_v2.blocks[4].option_examples.2","slug":null,"idx":null,"text":"（如：他已讀不回，可能是不小心按到，或是點開後手機沒電了。）","n":30,"ssz":".............................."},{"section":"served:spotlight_v2.blocks[4].option_examples.3","slug":null,"idx":null,"text":"（如：對方的委婉拒絕可能只是剛好沒空，我相信他一定對我有好感。）","n":32,"ssz":".................1..1..1........"},{"section":"served:spotlight_v2.blocks[4].option_examples.4","slug":null,"idx":null,"text":"（如：他沒約我打遊戲，也許是怕我作業太多會分心。）","n":25,"ssz":"........................."},{"section":"served:spotlight_v2.blocks[4].option_examples.5","slug":null,"idx":null,"text":"（如：他今天都沒跟我說話，不知道他怎麼了？晚點來關心他。）","n":29,"ssz":"............................."},{"section":"served:spotlight_v2.blocks[4].option_examples.6","slug":null,"idx":null,"text":"（如：他分組沒有找我，一定是因為上禮拜我沒陪他去福利社。）","n":29,"ssz":"...........1...1............."},{"section":"served:spotlight_v2.blocks[4].option_examples.7","slug":null,"idx":null,"text":"（如：雖然我的意見沒有被小組採用，但勇敢分享本身就是很棒的表現。）","n":33,"ssz":"................................."},{"section":"served:spotlight_v2.blocks[5].text","slug":null,"idx":null,"text":"回到文章，我們會看見，作者雖然是因為那份「喜歡」，所以十分在乎對方，以至於心情劇烈起伏，但影響情緒的關鍵也包含他的想法。所以當我們學會覺察想法，就能慢慢讓情緒變得穩定、有力量❤︎","n":89,"ssz":".................1..............................................................1........"},{"section":"served:keypoints.intro","slug":null,"idx":null,"text":"日記常用來記錄生活事件與心情感受，並藉此抒發情緒，上一篇小日記我們嘗試透過整理作者經歷的事件及感受來理解日記內容，這一篇也再試試看吧！","n":67,"ssz":"..................................................................."},{"section":"served:keypoints.columns[0]","slug":null,"idx":null,"text":"段落","n":2,"ssz":".."},{"section":"served:keypoints.columns[2]","slug":null,"idx":null,"text":"感受","n":2,"ssz":".."},{"section":"served:keypoints.rows[0].event","slug":null,"idx":null,"text":"上課時因為太在意他而分心，導致無法回答老師的問題","n":24,"ssz":"....1..................."},{"section":"served:keypoints.rows[0].feeling.instruction","slug":null,"idx":null,"text":"(勾選，可複選)","n":8,"ssz":"........"},{"section":"served:keypoints.rows[0].feeling.options.1","slug":null,"idx":null,"text":"尷尬","n":2,"ssz":".."},{"section":"served:keypoints.rows[0].feeling.options.2","slug":null,"idx":null,"text":"生氣","n":2,"ssz":".."},{"section":"served:keypoints.rows[0].feeling.options.3","slug":null,"idx":null,"text":"感到丟臉","n":4,"ssz":"...."},{"section":"served:keypoints.rows[1].event.value","slug":null,"idx":null,"text":"常常和他做（　）的選擇","n":11,"ssz":"..1........"},{"section":"served:keypoints.rows[1].event.options.1","slug":null,"idx":null,"text":"相同","n":2,"ssz":"1."},{"section":"served:keypoints.rows[1].event.options.2","slug":null,"idx":null,"text":"不同","n":2,"ssz":".."},{"section":"served:keypoints.rows[1].feeling","slug":null,"idx":null,"text":"期待有更多相處的機會","n":10,"ssz":".....1...."},{"section":"served:keypoints.rows[2].event","slug":null,"idx":null,"text":"看見他與別人談笑","n":8,"ssz":"........"},{"section":"served:keypoints.rows[2].feeling.options.2","slug":null,"idx":null,"text":"難過","n":2,"ssz":".."},{"section":"served:key