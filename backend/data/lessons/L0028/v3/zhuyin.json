l,"text":"人的眼睛，指不倚賴眼鏡或光學設備的視力。","n":20,"ssz":"...................."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"刨地","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"用爪子或工具挖地。","n":9,"ssz":"..1......"},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"雜草叢生","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"到處長滿雜草。","n":7,"ssz":".11...."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"層出不窮","n":4,"ssz":"...."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"接連不斷地出現。（注意：這個詞常用來形容壞事）。","n":24,"ssz":"..1.1........1.........."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"繁殖","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"生出新的生命，讓物種的數量增加。例如，老鼠生出小老鼠、植物的種子變成小苗，都是繁殖。","n":42,"ssz":"...............................1.........."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"救苦救難","n":4,"ssz":"...1"},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"提供救助，使人脫離痛苦與災難。","n":15,"ssz":".............1."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"效能","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"做事的效率和效果。「工作效能很好」指的是工作做得又快、又好。","n":30,"ssz":".....1.................1......"},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"這個花園多年無人管理，已經（　），整理恐怕要花一段時間。","n":28,"ssz":".1.....................1...."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"貓頭鷹和老鼠都是（　）的生物，白天休息，晚上才出來覓食。","n":28,"ssz":"...1........................"},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"這種昆蟲的（　）力很強，短短幾週，數量就增加到成千上萬隻。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"地震導致大量人員