,"idx":null,"text":"唾手可得","n":4,"ssz":"...1"},{"section":"served:vocabulary[1].definition","slug":null,"idx":null,"text":"往手上吐口水，比喻非常容易得到。同「易如反掌」。","n":24,"ssz":"...1...................."},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"枯燥乏味","n":4,"ssz":"...."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"單調、無趣。","n":6,"ssz":".1...."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"眷戀","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"懷念、不捨。","n":6,"ssz":"......"},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"如影隨形","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"像影子一直跟著人，比喻緊緊跟隨、難以擺脫。","n":21,"ssz":"..12................."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"格格不入","n":4,"ssz":"..1."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"不適合、難以融入。","n":9,"ssz":"1........"},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"恍然大悟","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"突然醒悟、明白。","n":8,"ssz":"........"},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"雀躍","n":2,"ssz":".."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"像雀鳥一樣跳躍，比喻非常開心、興奮。","n":18,"ssz":"...1.............."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"翻天覆地","n":4,"ssz":"...."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"形容變化非常大。同「天翻地覆」。","n":16,"ssz":"................"},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"嶄新","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"全新。","n":3,"ssz":"..."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"他穿著體育服出現在喜宴上，顯得非常 （　）。","n":22,"ssz":"..............1......."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"這十年來，科技的進步讓我們的生活發生（　）的變化。","n":25,"ssz":"........................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"自從他在眾人面前出糗後，犯錯的焦慮就（　），緊緊跟著他。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"「盛年不重來，一日難再晨」，美好的（　）要好好把握。","n":26,"ssz":".1.1......................"},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"畢業多年，他依然（　）著校園的一草一木。","n":20,"ssz":"...............2.1.."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"這場（　）的演講讓台下的人感到不耐煩，紛紛開始聊天。","n":26,"ssz":"...............1.........."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"經過多年的苦練與突破後，進入決賽對他來說已（　）。","n":25,"ssz":"........................."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"媽媽解釋完事情的來龍去脈後，我才（　），知道自己誤會弟弟了。","n":30,"ssz":".1.........................1.."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列語詞何者使用正確？","n":11,"ssz":"..........."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"寒流來襲時，海風吹來十分「雀躍」，令人不由自主的發抖","n":26,"ssz":".........................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"這座古蹟他已造訪數次，多年「嶄新」的風貌令他流連忘返","n":26,"ssz":".........................."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"這個巷道狹小，火災時，消防車進退兩難「格格不入」","n":24,"ssz":".1...................1.."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"在老師的一番引導下，他才對自己犯下的錯誤「恍然大悟」","n":26,"ssz":"....2....................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"關於「思念是烏雲，日積月累，不斷膨脹，遮住了我的笑容」，下列詮釋何者正確？","n":37,"ssz":"............1.1......................"},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"思念隨著時間越來越深，並且影響了心情","n":18,"ssz":".................."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"烏雲像思念一樣，當天氣不好時心情也不好","n":19,"ssz":".....1............."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"在思念時特別容易暴飲暴食，因此身形變胖","n":19,"ssz":"..................."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"在陰天時會特別思念，以至於無法展現笑容","n":19,"ssz":"..................."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據文章，作者在經歷小學升國中的歷程後有了新的體悟，下列何者最貼近作者的體悟？","n":39,"ssz":"......................................."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"離開熟悉環境後，只要回去找舊朋友，就能解決所有不適應。","n":27,"ssz":".......................1..."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"成長不是忘記過去，而是珍惜回憶，也學會告別並把握眼前。","n":27,"ssz":".11........................"},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"國中生活比小學辛苦，因此應盡量維持原本的生活方式。","n":25,"ssz":"........................."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"朋友有了新的關係後，過去的友情就不再值得珍惜。","n":23,"ssz":"................1..1..."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"下列文句的聯想和運用，何者正確？","n":16,"ssz":".......1........"},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"妹妹的個性像綿羊一樣火爆","n":12,"ssz":".1.1....1..."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"他嚴肅說話的樣子像個小丑","n":12,"ssz":".......1.1.."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"你閃亮的眼眸彷彿天上的星星","n":13,"ssz":"......1......"},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"從空中看，地上的房子好像雨滴","n":14,"ssz":".........1...."},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜210字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"211~240字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞241字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（三☞)開始朗讀，計時1分鐘讀的字數，並記錄在表格中。如果你計時3次後，對自己還不滿意，可以自己多練幾次喔。最後一次，找一位同學，請他來計時、記錄並簽名！","n":88,"ssz":"...............................................................1.......1................"},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"慢慢的，我發現自己和每個同學都能相談甚歡，卻不是","n":24,"ssz":".........1.1....1.....1."},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.answer_carrier","slug":null,"idx":null,"text":"紅色 ☑（w:sym Wingdings F0FE）＋橘色手寫填空；「請圈出譬喻關鍵字詞」的圈是橘色框（僅圖形層）","n":57,"ssz":"................................1........................"},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"《譬喻：用大家熟悉的事物(A)，說明或凸顯另一件事物(B)的特點 》\n譬喻是一種寫作常見的手法，它和「轉化」與「誇飾」一樣，都是運用聯想、想像力的方式，把一件事物比成另一件大家熟悉的事物，讓原本抽象的特點或感受變得更具體，也讓讀者更容易想像和感受。\n例１：「他的笑容像太陽。」→把「笑容」比成「太陽」，凸顯他的笑容帶給人溫暖、耀眼的感受。\n例2：「他的笑容像盛放的花。」→把「笑容」比成「盛放的花」，凸顯他的笑容帶給人美好、燦爛的感受。\n使用譬喻時，句子常會出現「好像」、「像」、「彷彿」、「如（同）」、「一樣」、「A（像）是B」等字詞。文章中使用譬喻的地方，常是作者特別想描寫或表達感受的地方。因此，閱讀時可以留意文章中的譬喻，想一想作者想表達什麼感受或想法。","n":331,"ssz":"......................................2..........1.........1..............................................1.............1.........................................................................................................1..............1...........1............................................................................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"《譬喻：用大家熟悉的事物(A)，說明或凸顯另一件事物(B)的特點 》","n":34,"ssz":".................................."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"譬喻是一種寫作常見的手法，它和「轉化」與「誇飾」一樣，都是運用聯想、想像力的方式，把一件事物比成另一件大家熟悉的事物，讓原本抽象的特點或感受變得更具體，也讓讀者更容易想像和感受。","n":89,"ssz":"...2..........1.........1..............................................1.............1..."},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"例１：「他的笑容像太陽。」→把「笑容」比成「太陽」，凸顯他的笑容帶給人溫暖、耀眼的感受。","n":44,"ssz":"............................................"},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"例2：「他的笑容像盛放的花。」→把「笑容」比成「盛放的花」，凸顯他的笑容帶給人美好、燦爛的感受。","n":48,"ssz":"................................................"},{"section":"served:spotlight_v2.blocks[0].text#line","slug":null,"idx":null,"text":"使用譬喻時，句子常會出現「好像」、「像」、「彷彿」、「如（同）」、「一樣」、「A（像）是B」等字詞。文章中使用譬喻的地方，常是作者特別想描寫或表達感受的地方。因此，閱讀時可以留意文章中的譬喻，想一想作者想表達什麼感受或想法。","n":112,"ssz":".......1..............1...........1............................................................................."},{"section":"served:spotlight_v2.blocks[1].text","slug":null,"idx":null,"text":"◎小試身手：","n":6,"ssz":"......"},{"section":"served:spotlight_v2.blocks[2].prompt","slug":null,"idx":nu