n":12,"ssz":"............"},{"section":"served:vocabulary[1].word","slug":null,"idx":null,"text":"風險意識","n":4,"ssz":"...."},{"section":"served:vocabulary[1].definition","slug":null,"idx":null,"text":"能察覺可能發生的危險，並事先防範的意識。","n":20,"ssz":"...................."},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"雷同","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"事物非常相似。","n":7,"ssz":"....1.."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"應驗","n":2,"ssz":"1."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"預言或推測後來真的發生了。","n":13,"ssz":"............."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"倖存者","n":3,"ssz":"..."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"在災難、事故或危險中存活下來的人。","n":17,"ssz":"..1.............."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"偏誤","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"思考或判斷時產生的偏差與錯誤。","n":15,"ssz":"..............."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"含糊其辭","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"說話或表達得不清楚，讓人難以知道真正的意思。","n":22,"ssz":".....1..............2."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"網路謠言引發不必要的（　），政府呼籲大家要冷靜。","n":24,"ssz":"......1................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"他把昨晚的驚悚電影說得（　），讓人聽得毛骨悚然。","n":24,"ssz":"..........1.......1....."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"當裁判舉起手準備宣布比賽結果時，全場（　），現場一片安靜。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"他看到幾個成功的創業故事，就以為創業一定能賺大錢，這種想法有（　），因為他忽略了失敗的案例。","n":46,"ssz":"....1.............1................1.........."},{"section":"served:fill