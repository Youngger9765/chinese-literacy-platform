","slug":null,"idx":null,"text":"採納","n":2,"ssz":".."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"接受別人的意見、方法或建議，並決定使用。","n":20,"ssz":"...................."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"概括","n":2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"把許多內容整理後，用較簡要的方式說出整體情況或重點。","n":26,"ssz":".........................."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"一文不值","n":4,"ssz":"...."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"比喻把人或事物說得毫無價值。","n":14,"ssz":"........1....."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"黯淡","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"指光線不明亮，也可形容未來不看好或表現不突出。","n":23,"ssz":".............1........."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"人身攻擊","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"不針對事情本身，而是攻擊一個人的外表、能力、身分或人格。","n":28,"ssz":".............1.........1...."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"失常","n":2,"ssz":".."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"表現失去平常的水準，沒有發揮平常的實力。","n":20,"ssz":"...................."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"混為一談","n":4,"ssz":"..2."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"把原本不同的事情當成同一件事來看或討論。","n":20,"ssz":"...................."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"迎合","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"刻意配合對方的喜好或想法。","n":13,"ssz":"........1...."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"揮之不去","n":4,"ssz":"..1."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"怎麼趕都趕不走，常形容記憶、情緒或念頭一直留在心中。","n":26,"ssz":"...................2......"},{"section":"served:vocabulary[11].word","slug":null,"idx":null,"text":"照單全收","n":4,"ssz":"...."},{"section":"served:vocabulary[11].definition","slug":null,"idx":null,"text":"比喻不加判斷，全盤接受別人的意見。","n":17,"ssz":"................."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"嚴格的老師不一定就是不關心學生，不要把嚴格和冷漠（　）。","n":28,"ssz":"......1.........1....1......"},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"球隊主力接連受傷，外界一度認為今年的奪冠希望十分（　）。","n":28,"ssz":"...........1................"},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"雖然事情已經過了很久，那句傷人的話仍在她心中（　）。","n":26,"ssz":".........................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"別人的建議可以參考，但不能不加思考就（　）。","n":22,"ssz":"......................"},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"經過熱烈的討論後，大家投票決定（　）第二組提出的方案。","n":27,"ssz":"..........................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"為了（　）大家的喜好，她勉強答應參加自己不感興趣的活動。","n":28,"ssz":"1........1...111......1....."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"老師請我們用一句話（　）這一段文章的重點。","n":21,"ssz":"......1......1......."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"一次比賽失敗，不代表之前所有的努力都變得（　）。","n":24,"ssz":".......1...........1...."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列選項中「  」的語詞，何者使用正確？","n":20,"ssz":"...................."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"他這場演講重點筆記很精采，把所有精華都「混為一談」","n":25,"ssz":"......................2.."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"每個人眼光不同，你認為「一文不值」，也有人視為珍寶","n":25,"ssz":".1..........2............"},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"他比較了三個建議後，只「照單全收」其中最有用的一項","n":25,"ssz":".....1.................1."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"面對他沒有興趣的活動，他常常直接拒絕並「揮之不去」","n":25,"ssz":".....1................1.."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據第五段，作者提出「他掌握的是事情的全貌，還是只有其中一小段？」這個問題，主要是要避免哪一種錯誤？","n":50,"ssz":"............................2.....1..........2...."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"因為一個人的身分，就認定他的話一定不會錯","n":20,"ssz":".1.1...1.......1.1.."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"因為別人的語氣不好，就完全不考慮他的意見","n":20,"ssz":".1.................."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"用局部資訊做出對整件事或整個人的全面判斷","n":20,"ssz":".............1......"},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"因為大多數人意見相同，就跟著改變自己想法","n":20,"ssz":".1......1..........."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據第八段「拉開距離，不是逃避，而是替自己留一點整理心情的空間。」這句話最適合怎麼理解？","n":44,"ssz":"...........1..........2....................."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"面對持續的惡意攻擊時，暫時離開也是保護自己的方法","n":24,"ssz":"........................"},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"只要別人的話讓自己感覺不適，就不需要再聽任何意見","n":24,"ssz":"...........1............"},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"遇到網路批評時，先停止使用社群網站才是最好的方式","n":24,"ssz":"........................"},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"不回應別人的評論，可以讓對方知道自己的態度更堅定","n":24,"ssz":"..1....................."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據本文，下列何者最符合文章主旨？","n":17,"ssz":"................."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"面對網路留言時，最好相信熟悉自己的人，不要相信陌生人","n":26,"ssz":"..........1........1.1...."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"別人的批評常會傷害自信，應該減少在網路上分享自己的生活","n":27,"ssz":"..........................."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"面對評價應先判斷內容是否有幫助，不要讓一句話否定自己","n":26,"ssz":"................1..1......"},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"每個人的喜好都不同，面對不同意見不需要和別人爭論對錯","n":26,"ssz":".1...1.............1......"},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"小妤要驗收運動會進場的舞蹈，阿青說：「你有兩個動作常比音樂慢半拍，可以先把那八拍單獨練熟。」燕燕則說：「你跳舞看起來很沒天分。」依照本文，小妤最適合怎麼想？","n":78,"ssz":"......................1.....1................................................."},{"section":"served:multiple_choice[4].options[0]","slug":null,"idx":null,"text":"兩個人都覺得她跳不好，所以她可能真的不適合跳舞","n":23,"ssz":".1...1............1...."},{"section":"served:multiple_choice[4].options[1]","slug":null,"idx":null,"text":"兩句都是負面的評價，為了維持信心，都先不要接受","n":23,"ssz":"..........1........1..."},{"section":"served:multiple_choice[4].options[2]","slug":null,"idx":null,"text":"阿青說得比較客氣，應該接受；燕燕說得難聽，所以不用理","n":26,"ssz":"...1.............1.....1.."},{"section":"served:multiple_choice[4].options[3]","slug":null,"idx":null,"text":"阿青提出可以改進之處值得參考；燕燕整體否定，不必收下","n":26,"ssz":".........1.1..........1..."},{"section":"served:reading_benchmark.levels[0].threshold","slug":null,"idx":null,"text":"＜200字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[0].feedback","slug":null,"idx":null,"text":"還要多加練習。","n":7,"ssz":"......."},{"section":"served:reading_benchmark.levels[1].threshold","slug":null,"idx":null,"text":"201~230字","n":8,"ssz":"........"},{"section":"served:reading_benchmark.levels[1].feedback","slug":null,"idx":null,"text":"嗯，還不錯喲！","n":7,"ssz":"...1..."},{"section":"served:reading_benchmark.levels[2].threshold","slug":null,"idx":null,"text":"＞231字","n":5,"ssz":"....."},{"section":"served:reading_benchmark.levels[2].feedback","slug":null,"idx":null,"text":"哇嗚，超級厲害！","n":8,"ssz":"........"},{"section":"served:key_reading.instruction","slug":null,"idx":null,"text":"請用計時器，從指定段落（七☞）開始朗讀，在表格中記錄1分鐘朗讀的字數。如果計時3次後，你對自己還不滿意，可以多練幾次。最後一次，找一位同學幫你計時、記錄並簽名！","n":80,"ssz":".................................................................1.............."},{"section":"served:key_reading.timing_table.columns[0]","slug":null,"idx":null,"text":"第1次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[1]","slug":null,"idx":null,"text":"第2次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[2]","slug":null,"idx":null,"text":"第3次計時","n":5,"ssz":"....."},{"section":"served:key_reading.timing_table.columns[3]","slug":null,"idx":null,"text":"裁判計時","n":4,"ssz":"...."},{"section":"served:key_reading.timing_table.unit","slug":null,"idx":null,"text":"字","n":1,"ssz":"."},{"section":"served:key_reading.start_text","slug":null,"idx":null,"text":"有些話雖然不好聽，卻指出了具體問題，其中可能有值","n":24,"ssz":"........................"},{"section":"served:text_type","slug":null,"idx":null,"text":"單","n":1,"ssz":"."},{"section":"served:spotlight_v2.blocks[0].text","slug":null,"idx":null,"text":"別人對我們的表現、外表或喜好，常常會有不同的看法。有些話能讓我們知道哪裡可以做得更好；有些只是對方的個人喜好；還有些只是嘲笑或否定。聽到評價時，不必急著相信，也不必每一句都拒絕。先學會分辨這是什麼樣的評價，再決定要不要接受。判斷時還要注意：對方看到的是完整情況，還是只看了一小部分，就對整件事下了結論。","n":151,"ssz":".............1.........................1..........1..1..................1...1...1..1.......................1............................2..1.......1..."},{"section":"served:spotlight_v2.blocks[1].text","slug":null,"idx":null,"text":"◎情境舉例：小晴拍了一張照片，傳給三位朋友看。","n":23,"ssz":"..........2............"},{"section":"served:spotlight_v2.blocks[2].headers[0]","slug":null,"idx":null,"text":"朋友","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[2].headers[1]","slug":null,"idx":null,"text":"說的話","n":3,"ssz":"..."},{"section":"served:spotlight_v2.blocks[2].rows[0][0]","slug":null,"idx":null,"text":"A.芳芳","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[2].rows[0][1]","slug":null,"idx":null,"text":"「人物有點暗，如果站到亮一點的地方拍，臉會更清楚。」","n":26,"ssz":"............2............."},{"section":"served:spotlight_v2.blocks[2].rows[1][0]","slug":null,"idx":null,"text":"B.小萱","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[2].rows[1][1]","slug":null,"idx":null,"text":"「我比較不喜歡這種拍照風格，我喜歡自然一點的。」","n":24,"ssz":"...................2...."},{"section":"served:spotlight_v2.blocks[2].rows[2][0]","slug":null,"idx":null,"text":"C.阿玖","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[2].rows[2][1]","slug":null,"idx":null,"text":"「這樣拍也太醜了吧！」","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[3].prompt","slug":null,"idx":null,"text":"1.誰的回應是提出怎麼做會更好？","n":16,"ssz":".....1.........."},{"section":"served:spotlight_v2.blocks[3].options[0]","slug":null,"idx":null,"text":"芳芳","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[3].options[1]","slug":null,"idx":null,"text":"小萱","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[3].options[2]","slug":null,"idx":null,"text":"阿玖","n":2,"ssz":".."},{"section":"served:spotlight_v2.blocks[4].prompt","slug":null,"idx":null,"text":"2.誰的回應主要是在說自己的喜好？","n":17,"ssz":".....1.........1."},{"section":"served:spotlight_v2.blocks[5].prompt","slug":null,"idx":null,"text":"3.誰的回應只是批評，沒有幫助？","n":16,"ssz":".....1.........."},{"section":"served:spotlight_v2.blocks[6].text","slug":null,"idx":null,"text":"◎認識不同的評價類型：","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[7].headers[0]","slug":null,"idx":null,"text":"評價類型","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[7].headers[1]","slug":null,"idx":null,"text":"怎麼判斷","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[7].headers[2]","slug":null,"idx":null,"text":"例子","n":2,"ssz":".1"},{"section":"served:spotlight_v2.blocks[7].rows[0][0]","slug":null,"idx":null,"text":"具體回饋","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[7].rows[0][1]","slug":null,"idx":null,"text":"指出可以檢查的具體問題，有時也會提出可以怎麼改。但還要看看這個說法有沒有道理、對方掌握的資訊是否完整。","n":51,"ssz":"..............................1...................."},{"section":"served:spotlight_v2.blocks[7].rows[0][2]","slug":null,"idx":null,"text":"「你講得有點快，重要的地方如果停一下，大家會比較容易聽懂。」","n":30,"ssz":"...1............1............."},{"section":"served:spotlight_v2.blocks[7].rows[1][0]","slug":null,"idx":null,"text":"個人喜好","n":4,"ssz":"...1"},{"section":"served:spotlight_v2.blocks[7].rows[1][1]","slug":null,"idx":null,"text":"說的是自己喜歡或不喜歡什麼，不一定代表事情本身好或不好。","n":28,"ssz":"...............1............"},{"section":"served:spotlight_v2.blocks[7].rows[1][2]","slug":null,"idx":null,"text":"「我比較喜歡深色的衣服。」","n":13,"ssz":"............."},{"section":"served:spotlight_v2.blocks[7].rows[2][0]","slug":null,"idx":null,"text":"無效批評","n":4,"ssz":"...."},{"section":"served:spotlight_v2.blocks[7].rows[2][1]","slug":null,"idx":null,"text":"只有嘲笑、辱罵或否定，或只憑一小部分就否定整體，沒有提供能幫助改進的資訊。","n":37,"ssz":"..............2..1..................."},{"section":"served:spotlight_v2.blocks[7].rows[2][2]","slug":null,"idx":null,"text":"「你的報告有夠爛。」","n":10,"ssz":".........."},{"section":"served:spotlight_v2.blocks[8].text","slug":null,"idx":null,"text":"判斷練習：請判斷下面每一句話比較接近哪一種評價。\nA.具體回饋　　B.個人喜好　　C.無效批評","n":47,"ssz":"...........1.......2..................1........"},{"section":"served:spotlight_v2.blocks[8].text#line","slug":null,"idx":null,"text":"判斷練習：請判斷下面每一句話比較接近哪一種評價。","n":24,"ssz":"...........1.......2...."},{"section":"served:spotlight_v2.blocks[8].text#line","slug":null,"idx":null,"text":"A.具體回饋　　B.個人喜好　　C.無效批評","n":22,"ssz":".............1........"},{"section":"served:spotlight_v2.blocks[9].items[0].stem","slug":null,"idx":null,"text":"「你的簡報字有點小，如果再放大一些，坐在後面的同學也看得到。」","n":31,"ssz":"...............2...........1..."},{"section":"served:spotlight_v2.blocks[9].items[1].stem","slug":null,"idx":null,"text":"「我比較不喜歡這首歌，我平常比較常聽節奏快一點的。」","n":26,"ssz":".....................2...."},{"section":"served:spotlight_v2.blocks[9].items[2].stem","slug":null,"idx":null,"text":"「你到底會不會畫畫？這張圖醜死了。」","n":18,"ssz":".....1............"},{"section":"served:spotlight_v2.blocks[9].items[3].stem","slug":null,"idx":null,"text":"「我覺得你上次那個髮型比較好看，我比較喜歡長一點的。」","n":27,"ssz":"...1....1.............2...."},{"section":"served:spotlight_v2.blocks[9].items[4].stem","slug":null,"idx":null,"text":"「我看了你今天最後一次打擊，你完全不會打球。」","n":23,"ssz":".................1....."},{"section":"served:spotlight_v2.blocks[9].items[5].stem","slug":null,"idx":null,"text":"「你剛剛說話有點太衝了，可能會嚇到同學，下次可以等情緒穩定一點再說。」","n":35,"ssz":".........1...................2....."},{"section":"served:spotlight_v2.blocks[9].items[6].stem","slug":null,"idx":null,"text":"「照片裡的人物有點暗，如果拍攝時面向窗戶，臉可能會更清楚。」","n":30,"ssz":".............................."},{"section":"served:spotlight_v2.blocks[9].items[7].stem","slug":null,"idx":null,"text":"「我覺得這本小說有點無聊，我比較喜歡節奏快一點的故事。」","n":28,"ssz":"...1.................2......"},{"section":"served:spotlight_v2.blocks[9].items[8].stem","slug":null,"idx":null,"text":"「你跑步的時候前面衝得太快，後半段才會沒力，下次可以試著把速度分配平均一點。」","n":39,"ssz":"..........1........................2..."},{"section":"served:spotlight_v2.blocks[9].items[9].stem","slug":null,"idx":null,"text":"「連這麼簡單的題目都不會，你真的很笨耶！」","n":21,"ssz":"..........1.........."},{"section":"served:spotlight_v2.blocks[10].text","slug":null,"idx":null,"text":"→不同的評價，可以有不同的處理方式\n1.如果是「具體回饋」：先看看有沒有道理、資訊是否完整，有幫助的部分，可以留下來試一試。\n2.如果是「個人喜好」：可以聽，但不用把別人的喜好當成標準。\n3.如果是「無效批評」：如果是反覆嘲笑、辱罵或網路攻擊，可以少看、離開、封鎖；需要時，截圖保存證據，並找信任的大人幫忙。","n":154,"ssz":"...................................................1....................1.......1......1.................................................................."},{"section":"served:spotlight_v2.blocks[10].text#line","slug":null,"idx":null,"text":"→不同的評價，可以有不同的處理方式","n":17,"ssz":"................."},{"section":"served:spotlight_v2.blocks[10].text#line","slug":null,"idx":null,"text":"1.如果是「具體回饋」：先看看有沒有道理、資訊是否完整，有幫助的部分，可以留下來試一試。","n":44,"ssz":".................................1.........."},{"section":"served:spotlight_v2.blocks[10].text#line","slug":null,"idx":null,"text":"2.如果是「個人喜好」：可以聽，但不用把別人的喜好當成標準。","n":30,"ssz":".........1.......1......1....."},{"section":"served:spotlight_v2.blocks[10].text#line","slug":null,"idx":null,"text":"3.如果是「無效批評」：如果是反覆嘲笑、辱罵或網路攻擊，可以少看、離開、封鎖；需要時，截圖保存證據，並找信任的大人幫忙。","n":60,"ssz":"............................................................"},{"section":"served:spotlight_v2.blocks[11].text","slug":null,"idx":null,"text":"◎收到評價可以這麼想：\n請根據上述分類和建議，選出比較適合的想法。","n":33,"ssz":"...................1............."},{"section":"served:spotlight_v2.blocks[11].text#line","slug":null,"idx":null,"text":"◎收到評價可以這麼想：","n":11,"ssz":"..........."},{"section":"served:spotlight_v2.blocks[11].text#line","slug":null,"idx":null,"text":"請根據上述分類和建議，選出比較適合的想法。","n":21,"ssz":".......1............."},{"section":"served:spotlight_v2.blocks[12].prompt","slug":null,"idx":null,"text":"1.你參加班級海報比賽，同學說：「標題和背景的顏色太接近，遠一點看不太清楚。」你可以想：","n":44,"ssz":"...................1..........2..1.........."},{"section":"served:spotlight_v2.blocks[12].options[0]","slug":null,"idx":null,"text":"他一定覺得我的海報很醜","n":11,"ssz":".1..1......"},{"section":"served:spotlight_v2.blocks[12].options[1]","slug":null,"idx":null,"text":"這評價是可以檢查的，我試著站遠一點看看","n":19,"ssz":"...............2..."},{"section":"served:spotlight_v2.blocks[12].options[2]","slug":null,"idx":null,"text":"先不理他了，我哪有力氣去管每個人的意見？","n":20,"ssz":"..............1....."},{"section":"served:spotlight_v2.blocks[12].options[3]","slug":null,"idx":null,"text":"既然有人給了負評，整張海報還是重做好了","n":19,"ssz":"...............1..."},{"section":"served:spotlight_v2.blocks[13].prompt","slug":null,"idx":null,"text":"2.朋友說：「我真的不懂你為什麼喜歡這個偶像，我覺得他很普通。」你可以想：","n":37,"ssz":".............1.....1.....1..........."},{"section":"served:spotlight_v2.blocks[13].options[0]","slug":null,"idx":null,"text":"他不喜歡，表示我眼光真的很差","n":14,"ssz":".............."},{"section":"served:spotlight_v2.blocks[13].options[1]","slug":null,"idx":null,"text":"好朋友說這種話，表示他很不尊重我","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[13].options[2]","slug":null,"idx":null,"text":"這是個人喜好，我和他的看法可以不一樣","n":18,"ssz":"..1..1..1.......1."},{"section":"served:spotlight_v2.blocks[13].options[3]","slug":null,"idx":null,"text":"我要找更多理由證明我的眼光比他好","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[14].prompt","slug":null,"idx":null,"text":"3.你在社群網站分享自己的作品，有人留言：「做這麼爛還敢貼出來，笑死人了。」你可以想：","n":43,"ssz":"..........................................."},{"section":"served:spotlight_v2.blocks[14].options[0]","slug":null,"idx":null,"text":"他講得這麼直接，應該是真的很差","n":15,"ssz":"..1............"},{"section":"served:spotlight_v2.blocks[14].options[1]","slug":null,"idx":null,"text":"我要馬上回罵，讓他知道我也不好惹","n":16,"ssz":"................"},{"section":"served:spotlight_v2.blocks[14].options[2]","slug":null,"idx":null,"text":"只要有人不喜歡，以後就不要再分享作品","n":18,"ssz":"...........1......"},{"section":"served:spotlight_v2.blocks[14].options[3]","slug":null,"idx":null,"text":"這句話只有嘲笑，沒有有用的建議，我不必照單全收","n":23,"ssz":".................1....."},{"section":"served:spotlight_v2.blocks[15].text","slug":null,"idx":null,"text":"→當我們成為給意見的人，請「用愛心說真話」，不是什麼都只說好聽的，也不是想到什麼就直接批評；要讓自己的話有幫助：說具體、說清楚，不用嘲笑，也不要因為一次表現就否定整個人。","n":85,"ssz":"......................1...........1.............................1.....1..1........1.."},{"section":"served:spotlight_v2.blocks[16].instruction","slug":null,"idx":null,"text":"如果你做得到，請在□打勾。","n":13,"ssz":"....1........"},{"section":"served:spotlight_v2.blocks[16].items[0]","slug":null,"idx":null,"text":"1.我能分辨一句評價是具體回饋、個人喜好，還是無效批評。","n":28,"ssz":"......1............1........"},{"section":"served:spotlight_v2.blocks[16].items[1]","slug":null,"idx":null,"text":"2.我能想想評價有沒有根據、是否只看片段，能不能幫助自己，再決定要不要接受。","n":38,"ssz":".................................1...."},{"section":"served:spotlight_v2.blocks[16].items[2]","slug":null,"idx":null,"text":"3.面對無效批評時，我知道可以拉開距離、保護自己或尋求幫助。","n":30,"ssz":".............................."},{"section":"served:spotlight_v2.blocks[16].items[3]","slug":null,"idx":null,"text":"4.當我要給別人意見時，我能試著指出具體的地方，讓自己的話更有幫助。","n":34,"ssz":".