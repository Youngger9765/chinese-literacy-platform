].word","slug":null,"idx":null,"text":"悠悠","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"形容冷靜、慢慢說話的樣子。","n":13,"ssz":"...........1."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"鑽牛角尖","n":4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"一直在無法解決的細節或小問題上，反覆思考，無法跳脫。","n":26,"ssz":".........................."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"游擊","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"棒球中防守二、三壘間的位置。","n":14,"ssz":".............."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"荒謬","n":2,"ssz":".."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"非常不合理，讓人覺得無法接受。","n":15,"ssz":".........1....."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"靦腆","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"害羞、難為情，有些不自在。","n":13,"ssz":".........1..."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"不可置信","n":4,"ssz":"...."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"無法相信；另一種用法是「難以置信」。","n":18,"ssz":"..1...2..........."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"五體投地","n":4,"ssz":"...."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"指雙膝、雙肘及頭頂等五處著地，形容非常佩服或崇拜。","n":25,"ssz":"............4............"},{"section":"served:vocabulary[11].word","slug":null,"idx":null,"text":"低潮","n":2,"ssz":".."},{"section":"served:vocabulary[11].definition","slug":null,"idx":null,"text":"情緒或狀況不佳的時期。","n":11,"ssz":"..........."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"他平常溫文有禮，竟會在街上破口大罵，真令人(    )。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"網路上充滿(    )的假訊息與詐騙，大