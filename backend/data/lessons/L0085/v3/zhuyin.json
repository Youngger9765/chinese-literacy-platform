:"細小、細緻。","n":6,"ssz":"......"},{"section":"served:vocabulary[1].word","slug":null,"idx":null,"text":"明察秋毫","n":4,"ssz":"...."},{"section":"served:vocabulary[1].definition","slug":null,"idx":null,"text":"形容人觀察事物仔細，就像能看見秋天鳥獸新長的細毛。","n":25,"ssz":"........................."},{"section":"served:vocabulary[2].word","slug":null,"idx":null,"text":"徵兆、前兆","n":5,"ssz":"....."},{"section":"served:vocabulary[2].definition","slug":null,"idx":null,"text":"指事情發生前所出現的跡象。（提示：有兩個詞）","n":22,"ssz":"...................1.."},{"section":"served:vocabulary[3].word","slug":null,"idx":null,"text":"遠山如洗","n":4,"ssz":"...."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"形容遠處山景清晰明亮，像被清洗過。","n":17,"ssz":"...1............."},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"彷彿","n":2,"ssz":"1."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"好像。","n":3,"ssz":"..."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"即將","n":2,"ssz":".."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"表示事情快要發生。","n":9,"ssz":"........."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"坐立難安","n":4,"ssz":"...."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"形容人或動物心情焦躁、不安穩，坐也不是、站也不是。","n":25,"ssz":".................1....1.."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"焦躁不安","n":4,"ssz":"...."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"焦急不耐煩的樣子。","n":9,"ssz":"..1....1."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"歷歷在目","n":4,"ssz":"...."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"通常形容記憶中的畫面清楚的在眼前。本文則指畫面很清楚。","n":27,"ssz":"..........................."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"頻率","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"指在一段時間內同一件事情發生的次數。發生次數越多，頻率就越高。","n":31,"ssz":"..1............................"},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"他因車禍被送進醫院，在急診室外的家屬（　），不停來回踱步。","n":29,"ssz":"............................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"這位警察辦案非常認真，總是能（　），順利破案。","n":23,"ssz":"......................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"雨後的清晨，空氣格外清新，抬頭望去，（　），景物看得一清二楚。","n":31,"ssz":".........................12...."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"那天看牙醫的恐怖經驗（　），讓我想到就不寒而慄。","n":24,"ssz":"........................"},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"她流鼻水可能是感冒的（　），要及早治療以免加重病情。","n":26,"ssz":".........................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"這台機器故障的（　）太高，該換新的了。","n":19,"ssz":"..................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"畫家用（　）的筆觸畫出雲朵的柔軟感。","n":18,"ssz":".................."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"天空的雲層很低，（　）隨手就能觸碰到。","n":19,"ssz":"..................."},{"section":"served:vocab_bank.F","slug":null,"idx":null,"text":"徵兆","n":2,"ssz":".."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列語詞，何者使用正確？","n":12,"ssz":"............"},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"他「坐立不安」在沙發上閱讀，十分投入","n":18,"ssz":".................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"我想「明察秋毫」一下這杯飲料的味道","n":17,"ssz":"........1........"},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"小樹「纖細」的枝芽，禁不起風吹雨打","n":17,"ssz":"..........1......"},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"我「即將」在昨天看一場精采的電影","n":16,"ssz":".........2......"},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據文章，下列哪一項動物行為可能預示「快要下雨」？","n":25,"ssz":"........1................"},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"蜘蛛結大網","n":5,"ssz":"....."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"狗狗不停的在屋子裡走動","n":11,"ssz":".......1..."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"蟋蟀叫聲速度變慢","n":8,"ssz":"........"},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"鳥類在空中不停盤旋","n":9,"ssz":"........."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"文章中提到：「你皺起眉頭，拿起掃把想把牠揮掉。且慢！」這段話中的「且慢」最可能代表什麼意思？","n":46,"ssz":"...............1............................2."},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"作者要呼喚他人幫忙處理蜘蛛","n":13,"ssz":"............."},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"提醒主角先停下來、仔細觀察","n":13,"ssz":"...1........."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"作者想用宏亮的聲音嚇退蜘蛛","n":13,"ssz":"............."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"作者流露出對蜘蛛的強烈憤怒","n":13,"ssz":"...1........."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"依據本文，當家裡的狗狗坐立難安、貓咪亂躲藏時，你外出時可能需要準備什麼？","n":36,"ssz":"...................................."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"手電筒","n":3,"ssz":"..."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"毛帽","n":2,"ssz":".."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"太陽眼鏡","n":4,"ssz":"...."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"雨具","n":2,"ssz":".."},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"本文透過蜘蛛、蟋蟀、狗、貓行為與天空現象等例子進行說明。作者最想傳達的核心觀念是下列何者？","n":45,"ssz":"...