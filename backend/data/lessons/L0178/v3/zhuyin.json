2,"ssz":".."},{"section":"served:vocabulary[3].definition","slug":null,"idx":null,"text":"指做一件事之後得到的效果或成果。","n":16,"ssz":"................"},{"section":"served:vocabulary[4].word","slug":null,"idx":null,"text":"一味","n":2,"ssz":".."},{"section":"served:vocabulary[4].definition","slug":null,"idx":null,"text":"只照著同一種想法或方式去做，不考慮其他情況。","n":22,"ssz":"....2................."},{"section":"served:vocabulary[5].word","slug":null,"idx":null,"text":"濛濛亮","n":3,"ssz":"..."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"天剛開始亮，光線還不十分明亮。","n":15,"ssz":"..............."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"鮮少","n":2,"ssz":"1."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"指很少、不常有。","n":8,"ssz":"........"},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"高峰","n":2,"ssz":".."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"原指山最高的地方；也比喻發展、表現或成就達到最好的階段。","n":28,"ssz":"............................"},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"突出","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"超出一般的程度，特別明顯或優秀。","n":16,"ssz":"..2............."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"疲憊","n":2,"ssz":".."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"身體或精神非常疲累，感到沒有力氣。","n":17,"ssz":"................."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"逐步","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"一步一步、慢慢進行或改變。","n":13,"ssz":"............."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"一整天的校外教學結束後，同學們雖然（　），心情卻很愉快。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"這個山區冬天天氣寒冷，十分荒涼，（　）有遊客前來。","n":25,"ssz":".1......................."},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"身體已經受傷，就不能（　）忍痛練習，應該先接受檢查。","n":26,"ssz":".........................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"這位歌手正值事業（　）時，檢查出罹患了癌症，令人震驚。","n":27,"ssz":"..........................."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"小恩在繪畫方面表現（　），作品多次代表學校參賽。","n":24,"ssz":"........................"},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"老師先教基本操作，再一個個增加新功能，讓大家（　）學會使用新的軟體。","n":34,"ssz":".................................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"她轉學後花了一段時間適應新環境，也在過程中培養出面對改變的（　）。","n":33,"ssz":"......1....1....................."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"她每天固定複習英文單字，幾個月後終於看見努力的（　）。","n":27,"ssz":".............1............."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"下列選項中「  」的語詞，何者使用正確？","n":20,"ssz":"...................."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"在走廊上要盡量避免「逐步」聊天，這樣會占用到行走空間","n":26,"ssz":".........................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"他經常做了「韌性」的決定，然後要別人一起幫他承擔後果","n":26,"ssz":"..................2......."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"經過三個月的作息調整，他精神變得很好，已經能看見「成效」","n":28,"ssz":"...1...........1............"},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"今天的午後雷陣雨非常「突出」，讓在路上的行人措手不及","n":26,"ssz":".........................."},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據第四段，林詩翔調整動作後，「球速沒有立刻變快，也沒有人因此替他鼓掌」，作者最可能想凸顯什麼？","n":48,"ssz":"................................................"},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"真正重要的練習通常不會受到其他人的注意","n":19,"ssz":".........1........."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text":"有些調整需要時間累積，努力不一定馬上看見成果","n":22,"ssz":"........1.....1......."},{"section":"served:multiple_choice[1].options[2]","slug":null,"idx":null,"text":"練習時太在意別人的肯定，容易讓人忽略自己的進步","n":23,"ssz":"......................."},{"section":"served:multiple_choice[1].options[3]","slug":null,"idx":null,"text":"改變原有動作可能暫時退步，因此需要忍受別人質疑","n":23,"ssz":".....................1."},{"section":"served:multiple_choice[2].question","slug":null,"idx":null,"text":"根據本文，林智勝受傷前後，看待棒球的態度有什麼不同轉變？","n":28,"ssz":"............................"},{"section":"served:multiple_choice[2].options[0]","slug":null,"idx":null,"text":"從只盯著成績，轉為看見改進方向和打棒球的意義","n":22,"ssz":"...............1......"},{"section":"served:multiple_choice[2].options[1]","slug":null,"idx":null,"text":"從重視個人成績，轉為只會在意球隊能不能取得勝利","n":23,"ssz":"......................."},{"section":"served:multiple_choice[2].options[2]","slug":null,"idx":null,"text":"從希望成為知名球員，轉為不再那麼在意自己的表現","n":23,"ssz":"............1.........."},{"section":"served:multiple_choice[2].options[3]","slug":null,"idx":null,"text":"從堅定相信努力會有成果，轉為接受自己身體的限制","n":23,"ssz":"...1..................."},{"section":"served:multiple_choice[3].question","slug":null,"idx":null,"text":"根據本文，下列何者最符合文章主旨？","n":17,"ssz":"................."},{"section":"served:multiple_choice[3].options[0]","slug":null,"idx":null,"text":"長期勤奮練習，即使起步較慢，最後仍可能等到成功的機會","n":26,"ssz":".........................."},{"section":"served:multiple_choice[3].options[1]","slug":null,"idx":null,"text":"面對挫折時，要相信自己的能力，不因一時失敗而輕易放棄","n":26,"ssz":".......1.................."},{"section":"served:multiple_choice[3].options[2]","slug":null,"idx":null,"text":"不見成果時，不必急著放棄，持續累積能力終究能看見進步","n":26,"ssz":"1.....1........1.........."},{"section":"served:multiple_choice[3].options[3]","slug":null,"idx":null,"text":"面對困境時，不只持續努力，也要調整方法或重新選擇方向","n":26,"ssz":"....................1....."},{"section":"served:multiple_choice[4].question","slug":null,"idx":null,"text":"小傑練三分球已經一段時間，目前十球大約只