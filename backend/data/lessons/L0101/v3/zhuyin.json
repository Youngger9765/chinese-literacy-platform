4,"ssz":"...."},{"section":"served:vocabulary[5].definition","slug":null,"idx":null,"text":"各自具有不同的優點或特色。","n":13,"ssz":"............."},{"section":"served:vocabulary[6].word","slug":null,"idx":null,"text":"款待","n":2,"ssz":".."},{"section":"served:vocabulary[6].definition","slug":null,"idx":null,"text":"熱情而周到地招待客人，以表達歡迎與重視。","n":20,"ssz":".....1.............."},{"section":"served:vocabulary[7].word","slug":null,"idx":null,"text":"伴手禮","n":3,"ssz":"..."},{"section":"served:vocabulary[7].definition","slug":null,"idx":null,"text":"探訪或旅行時帶回送人的禮物。","n":14,"ssz":".............."},{"section":"served:vocabulary[8].word","slug":null,"idx":null,"text":"祖靈","n":2,"ssz":".."},{"section":"served:vocabulary[8].definition","slug":null,"idx":null,"text":"原住民族信仰中守護族人的祖先靈體。","n":17,"ssz":"................."},{"section":"served:vocabulary[9].word","slug":null,"idx":null,"text":"豐年祭","n":3,"ssz":"..."},{"section":"served:vocabulary[9].definition","slug":null,"idx":null,"text":"原住民族為感謝收成而舉行的重要祭典。","n":18,"ssz":".................."},{"section":"served:vocabulary[10].word","slug":null,"idx":null,"text":"酒麴","n":2,"ssz":".."},{"section":"served:vocabulary[10].definition","slug":null,"idx":null,"text":"釀酒時用來促進發酵的菌種物質。","n":15,"ssz":"..............."},{"section":"served:vocabulary[11].word","slug":null,"idx":null,"text":"展現無遺","n":4,"ssz":"...."},{"section":"served:vocabulary[11].definition","slug":null,"idx":null,"text":"完整呈現、毫無保留的表現出來。","n":15,"ssz":"..............."},{"section":"served:vocabulary[12].word","slug":null,"idx":null,"text":"分寸","n":2,"ssz":".."},{"section":"served:vocabulary[12].definition","slug":null,"idx":null,"text":"言行舉止的適度與界線。例如，在葬禮中嬉笑，就是「沒有分寸」。","n":30,"ssz":".............................."},{"section":"served:fill_in_blank[0].sentence","slug":null,"idx":null,"text":"青年們接受嚴格的生存挑戰，成功通過（　），獲得族人發給的勇士羽飾。","n":33,"ssz":"................................."},{"section":"served:fill_in_blank[1].sentence","slug":null,"idx":null,"text":"比賽輸了之後，他情緒激動，大吼大叫，言行開始失去（　）。","n":28,"ssz":"............................"},{"section":"served:fill_in_blank[2].sentence","slug":null,"idx":null,"text":"我們準備了豐盛的食物和小米酒，熱情（　）遠道而來的客人。","n":28,"ssz":"......1...1................."},{"section":"served:fill_in_blank[3].sentence","slug":null,"idx":null,"text":"他挑選部落手工小米酒作為（　），希望讓朋友嘗嘗家鄉的風味。","n":29,"ssz":".1..........................."},{"section":"served:fill_in_blank[4].sentence","slug":null,"idx":null,"text":"兩部電影的手法（　），一部溫柔婉約，另一部陽剛熱血。","n":26,"ssz":".........................."},{"section":"served:fill_in_blank[5].sentence","slug":null,"idx":null,"text":"工藝師在每一道雕刻中投入心血，他精湛的技藝在成品上（　）。","n":29,"ssz":".....1......................."},{"section":"served:fill_in_blank[6].sentence","slug":null,"idx":null,"text":"面對族裡的重要祭儀，他們（　），不敢有絲毫輕忽或不敬。","n":27,"ssz":"........................1.."},{"section":"served:fill_in_blank[7].sentence","slug":null,"idx":null,"text":"網路已成為現代社會最重要的（　），使資訊得以迅速流通。","n":27,"ssz":"..........................."},{"section":"served:multiple_choice[0].question","slug":null,"idx":null,"text":"請問下列語詞，何者使用錯誤？","n":14,"ssz":".............."},{"section":"served:multiple_choice[0].options[0]","slug":null,"idx":null,"text":"她臉上的表情，已將內心的緊張「展現無遺」","n":20,"ssz":"...................."},{"section":"served:multiple_choice[0].options[1]","slug":null,"idx":null,"text":"每一次挫折都是人生給我們的「試煉」，讓我們變得更成熟","n":26,"ssz":"......................1..."},{"section":"served:multiple_choice[0].options[2]","slug":null,"idx":null,"text":"兩位選手的表現完全相同，真是「各有千秋」","n":20,"ssz":".........1.........."},{"section":"served:multiple_choice[0].options[3]","slug":null,"idx":null,"text":"老師提醒同學玩笑可以開，但要有「分寸」，不能過頭","n":24,"ssz":"........................"},{"section":"served:multiple_choice[1].question","slug":null,"idx":null,"text":"根據第二段，釀造小米酒時，族人共同遵守哪一項要求？","n":25,"ssz":"....................1.1.."},{"section":"served:multiple_choice[1].options[0]","slug":null,"idx":null,"text":"在晚上進行，避免受到陽光影響","n":14,"ssz":".............."},{"section":"served:multiple_choice[1].options[1]","slug":null,"idx":null,"text