# Private notes (strategy, personal context)
private/

# Environment variables (secrets)
venv/
.venv/
.env
.env.local
.env.production

# Dependencies
node_modules/
__pycache__/
*.pyc

# Build outputs
dist/
build/

# Raw teaching materials (1GB+, not for git)
data/raw-materials/

# Test artifacts
*.db
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/
frontend/e2e/screenshots/
frontend/e2e-report.html

# Load test reports (generated artifacts — not committed)
tests/load-testing/reports/
tests/load-testing/.venv/

# Claude worktrees (temporary, per-issue)
.claude/worktrees/

# macOS
.DS_Store
.gstack/
.worktrees/

# Firebase deploy cache
.firebase/

# Transient logs + scratch workspace
logs/
workspace/

# /issue-fix skill outputs — work-progress notes, posted to PRs/issues, not committed
issue*done.md

# Content Evidence Gate (#2397) — re-shootable artifacts (screenshots / api payloads / logs)
# stay local; the *.jsonl + coverage_manifest.json records ARE committed as evidence.
qa/content-evidence/*/artifacts/
