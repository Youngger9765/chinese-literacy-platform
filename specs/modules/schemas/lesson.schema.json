{
  "$id": "lingoleap/module/lesson",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "從 175 份實測 yml 長出來，不是手寫的。required = 每一課都有的欄位（少了就是回歸）；properties 列出所有已觀測欄位，配合 additionalProperties: false —— 現況全過，任何新發明的欄位名會紅。",
  "properties": {
    "catalog_slot": {
      "type": "string",
      "x-seen-in": "175/175"
    },
    "sections_present": {
      "type": "array",
      "x-seen-in": "175/175"
    },
    "source": {
      "type": "object",
      "x-seen-in": "175/175"
    },
    "title": {
      "type": "string",
      "x-seen-in": "175/175"
    },
    "parts": {
      "type": "array",
      "x-seen-in": "7/175",
      "description": "一份學習單包多篇文章時，每一篇的身分（#2916）。有序清單 —— **順序就是排列**，不另存 order。`id` 是不透明 5 碼、永不修改也永不重用（QR 印在紙上）；`label` 給人看、隨便改。沒有 parts 的課視為單篇。",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[34679acdefhjkmnpqrtuvwxy]{5}$"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "catalog_slot",
    "sections_present",
    "source",
    "title"
  ],
  "title": "lesson module payload",
  "type": "object",
  "x-core-90pct": [
    "catalog_slot",
    "sections_present",
    "source",
    "title"
  ],
  "x-enforcement": "error",
  "x-lessons-observed": 175
}
