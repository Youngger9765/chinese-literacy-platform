        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/!(api|assets|q)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/!(api|assets|q)/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": "frontend/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "lingoleap-backend-staging",
            "region": "asia-east1"
          }
        },
        {
          "source": "/assets/**",
          "run": {
            "serviceId": "lingoleap-backend-staging",
            "region": "asia-east1"
          }
        },
        {
          "source": "/q/**",
          "run": {
            "serviceId": "lingoleap-backend-staging",
            "region": "asia-east1"
          }
        },
        {
          "source": "**",
